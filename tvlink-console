    with tempfile.TemporaryDirectory() as tmp:
        us = Units(os.path.join(tmp, "units.json"))
        us.add(unit_from_form(good))
        assert list(us.load()) == ["tv-lobby-01"] and "name" not in us.load()["tv-lobby-01"]
        assert os.stat(us.path).st_mode & 0o777 == 0o600
        try:
            us.add(unit_from_form(good))
            raise AssertionError("duplicate")
        except ValueError:
            pass
        assert us.remove("tv-lobby-01") and not us.remove("tv-lobby-01") and us.load() == {}
    # The badge, as the TV's: live, cached (server error), offline (no answer), or the unit is unreachable
    assert badge(None) == ("bad", "Unreachable") and badge({"state": "ready"}) == ("live", "Live")
    assert badge({"state": "waiting", "code": "503", "host": "b.example.com"}) == ("warn", "Cached")
    assert badge({"state": "waiting", "code": "000", "host": "b.example.com"}) == ("bad", "Offline")
    assert badge({"state": "network", "host": "b.example.com"}) == ("bad", "Offline")
    assert badge({"state": "folder", "host": ""}) == ("live", "Local Content")
    assert badge({"state": "setup"}) == ("warn", "Ready to Set Up")
    assert ago(1000, 1030) == "Just now" and ago(1000, 1000 + 3700) == "1 h 1 min ago"

    # Remote, against stand-in units: the tokens it sends, redirects never followed, every failure says what to check
    seen = []

    class Unit(BaseHTTPRequestHandler):
        def log_message(self, *args):
            pass

        def answer(self, code, body, ctype="application/json", headers=()):
            data = body if isinstance(body, bytes) else json.dumps(body).encode()
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            for k, v in headers:
                self.send_header(k, v)
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self):
            seen.append((self.path, self.headers))  # names: any case
            kind, path = self.path.split("/", 2)[1:]
            if kind == "slow":
                time.sleep(1)
            if kind == "access":  # Access without a good service token: off to its login page
                return self.answer(302, b"", "text/html", [("Location", "https://t.cloudflareaccess.com/login")])
            if kind == "deny":
                return self.answer(403, b"<h1>Forbidden</h1>", "text/html")
            if kind == "revoked":
                return self.answer(401, {"error": "Log in"})
            if path == "api/screenshot":
                return self.answer(200, b"\xff\xd8JPEG", "image/jpeg")
            self.answer(200, {"name": kind, "state": "ready", "tv": "on", "version": "0.1.0", "screenshot": 1700000000,
                              "health": []})

        def do_POST(self):
            seen.append((self.path, self.headers))  # names: any case
            body = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
            if "OVERLAY_CORNER" in body:
                return self.answer(400, {"error": "OVERLAY_CORNER is ...", "key": "OVERLAY_CORNER"})
            self.answer(200, {"ok": True, "message": f"did {body.get('action')}"})

    srv = ThreadingHTTPServer(("127.0.0.1", 0), Unit)
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    at = lambda kind, **kw: {"url": f"http://127.0.0.1:{srv.server_port}/{kind}", "token": "tvl_t", **kw}
    fast = Remote("fast", at("fast", access_id="id.access", access_secret="sec"))
    s = fast.status()
    h = seen[-1][1]
    assert s["tv"] == "on" and s["health"] == [] and SEEN["fast"]["status"]["version"] == "0.1.0"
    assert h["Authorization"] == "Bearer tvl_t" and h["CF-Access-Client-Id"] == "id.access"
    assert h["CF-Access-Client-Secret"] == "sec" and "Cookie" not in h
    Remote("plain", at("plain")).status()
    assert "CF-Access-Client-Id" not in seen[-1][1]
    assert fast.screen() == (b"\xff\xd8JPEG", 1700000000)
    n = len(seen)
    assert fast.screen()[0] == b"\xff\xd8JPEG" and len(seen) == n  # the same screenshot is fetched once
    assert fast.action("reload") == (True, "did reload")
    assert fast.save({"OVERLAY_CORNER": "middle"}) == (False, "OVERLAY_CORNER is ...", "OVERLAY_CORNER")
    n = len(seen)
    for kind, says in (("access", "Cloudflare Access service token"), ("deny", "HTTP 403"),
                       ("revoked", "refused its API token")):
        try:
            Remote(kind, at(kind)).status()
            raise AssertionError(kind)
        except UnitError as err:
            assert says in str(err), err
    assert len(seen) == n + 3  # the redirect was not followed
    # poll: all at once; a slow or dead unit shows as such without holding up the page, and lands later
    dead = {"url": "http://127.0.0.1:9/x", "token": "tvl_t"}  # the discard port: refused
    t0 = time.monotonic()
    got = poll({"fast": at("fast"), "slow": at("slow"), "dead": dead}, wait=0.4)
    assert time.monotonic() - t0 < 0.9, time.monotonic() - t0
    assert got["fast"][0]["tv"] == "on" and got["slow"] == (None, "No answer yet")
    assert got["dead"][0] is None and "No answer from dead" in got["dead"][1]
    BUSY["slow"].result(5)
    assert SEEN["slow"]["status"]["name"] == "slow" and poll({"slow": at("slow")}, wait=2)["slow"][0]
    srv.shutdown()


