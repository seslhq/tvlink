# Fleet mode: units reached through their API

class UnitError(Exception):
    """A unit that did not answer, or not as a tvlink console: the message says what to check."""


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        return None  # never: a redirect would carry the unit's tokens to wherever it points


OPENER = urllib.request.build_opener(NoRedirect)
SEEN, SHOTS, BUSY = {}, {}, {}  # per unit: last answer {time, status}; last screenshot (time, JPEG); fetch under way
# ponytail: in memory, so last seen starts over when the fleet restarts; keep it in a file if that matters.
POOL = concurrent.futures.ThreadPoolExecutor(16)


def unit_from_form(form):
    """A unit to store from the Units form, checked: name, url, token, access_id, access_secret. Raises ValueError."""
    u = {k: (form.get(k) or "").strip() for k in ("name", "url", "token", "access_id", "access_secret")}
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,39}", u["name"]):
        raise ValueError("Name is 1 to 40 letters, digits, dots, dashes or underscores, eg tv-lobby-01")
    url = urlsplit(u["url"])
    try:
        url.port
    except ValueError:
        raise ValueError("The port in the URL is not a number")
    if url.scheme not in ("http", "https") or not url.hostname or "@" in url.netloc or url.query or url.fragment \
            or not re.fullmatch(r"[A-Za-z0-9.:\[\]/_-]+", u["url"]):
        raise ValueError("URL is the unit's address, eg https://tv-lobby-01.example.com")
    u["url"] = u["url"].rstrip("/")
    if not re.fullmatch(r"[A-Za-z0-9_-]{20,200}", u["token"]):
        raise ValueError("API token is the one made on the unit's API Tokens page, eg tvl_...")
    if bool(u["access_id"]) != bool(u["access_secret"]):
        raise ValueError("A Cloudflare Access service token needs both its client ID and its secret")
    for k in ("access_id", "access_secret"):
        if not re.fullmatch(r"[\x21-\x7e]{0,200}", u[k]):  # header values: printable, no spaces
            raise ValueError("The Access client ID and secret have no spaces")
    return u


class Units:
    """The fleet's units by name, with the tokens to reach them: one JSON file, readable by the fleet user only."""

    def __init__(self, path):
        self.path, self.lock = path, threading.Lock()

    def load(self):
        try:
            return json.loads(read_file(self.path) or "{}")
        except ValueError:
            return {}

    def add(self, unit):
        with self.lock:
            units = self.load()
            if unit["name"] in units:
                raise ValueError(f"A unit named {unit['name']} already exists: remove it first to change it")
            units[unit.pop("name")] = unit
            write_file(self.path, json.dumps(units, indent=1))

    def remove(self, name):
        with self.lock:
            units = self.load()
            if units.pop(name, None) is None:
                return False
            write_file(self.path, json.dumps(units, indent=1))
        SEEN.pop(name, None)
        SHOTS.pop(name, None)
        return True


class Remote:
    """One unit through its console's API, with the same calls as LOCAL, so the same pages serve both."""

    def __init__(self, name, unit):
        self.name, self.u = name, unit

    def call(self, method, path, body=None, timeout=15):
        """(HTTP code, body bytes, content type). Raises UnitError when there is no usable answer."""
        headers = {"Authorization": f"Bearer {self.u['token']}", "User-Agent": "tvlink-fleet"}
        if self.u.get("access_id"):  # Cloudflare Access service token
            headers |= {"CF-Access-Client-Id": self.u["access_id"], "CF-Access-Client-Secret": self.u["access_secret"]}
        data = None if body is None else json.dumps(body).encode()
        if data:
            headers["Content-Type"] = "application/json"
        req = urllib.request.Request(self.u["url"] + path, data, headers, method=method)
        try:
            with OPENER.open(req, timeout=timeout) as r:
                return r.status, r.read(16 * 2**20), r.headers.get_content_type()
        except urllib.error.HTTPError as err:
            code, ctype, where = err.code, err.headers.get_content_type(), err.headers.get("Location", "")
            text = err.read(65536)
        except (OSError, http.client.HTTPException, ValueError) as err:  # URLError and timeouts are OSErrors
            why = getattr(err, "reason", err)
            raise UnitError(f"No answer from {self.name}: {getattr(why, 'strerror', None) or why}")
        if 300 <= code < 400:
            raise UnitError(f"{self.name} sent us to a login page" + (": check its Cloudflare Access service token"
                            if "cloudflareaccess.com" in where else f" ({code})"))
        if code == 401 and ctype == "application/json":
            raise UnitError(f"{self.name} refused its API token: make a new one on its API Tokens page")
        if ctype != "application/json":
            raise UnitError(f"{self.name} answered HTTP {code}, not as a tvlink console" +
                            (": check its Cloudflare Access service token" if code == 403 else ""))
        return code, text, ctype

    def json(self, method, path, body=None, timeout=15):
        code, text, ctype = self.call(method, path, body, timeout)
        try:
            data = json.loads(text)
        except ValueError:
            data = None
        if ctype != "application/json" or not isinstance(data, dict):
            raise UnitError(f"{self.name} answered HTTP {code}, not as a tvlink console")
        return code, data

    def status(self, brief=False, timeout=30):
        code, s = self.json("GET", "/api/status" + ("?brief=1" if brief else ""), timeout=timeout)
        if code != 200 or not isinstance(s.get("health", []), list):
            raise UnitError(s.get("error") or f"{self.name} answered HTTP {code}")
        SEEN[self.name] = {"time": time.time(), "status": s}
        return {"name": self.name, "ip": "", "version": "", "state": "", "screen": "Unknown", "host": "",
                "tv": "unknown", "tunnel": "", "uptime": 0, "health": [], "screenshot": None, **s}

    def schema(self):
        code, s = self.json("GET", "/api/settings")
        if code != 200 or not isinstance(s.get("keys"), list):
            raise UnitError(s.get("error") or f"{self.name} answered HTTP {code}")
        return s

    def save(self, changes):
        if not changes:
            return True, "Nothing changed", None
        code, r = self.json("POST", "/api/settings", changes, timeout=330)
        return (True, r.get("message", "Saved"), None) if code == 200 else (False, r.get("error", ""), r.get("key"))

    def action(self, name):
        code, r = self.json("POST", "/api/action", {"action": name}, timeout=90)
        return code == 200 and r.get("ok", False), r.get("message") or r.get("error") or ""

    def update(self, url, sha256):
        code, r = self.json("POST", "/api/update", {"url": url, "sha256": sha256}, timeout=360)
        return code == 200 and r.get("ok", False), r.get("message") or r.get("error") or ""

    def logs(self, which=LOGS):
        code, r = self.json("GET", "/api/logs")
        return {w: str(r.get(w, "")) for w in which}

    def networks(self):
        return self.json("GET", "/api/wifi")[1].get("networks", [])

    def screen(self):
        """(JPEG, time) of the unit's last screenshot, fetched once per screenshot; the last one we have when it is
        down."""
        taken, have = (SEEN.get(self.name) or {}).get("status", {}).get("screenshot"), SHOTS.get(self.name)
        if have and (have[0] == taken or not taken):
            return have[1], have[0]
        try:
            code, data, ctype = self.call("GET", "/api/screenshot", timeout=15)
        except UnitError:
            return (have[1], have[0]) if have else (None, None)
        if code != 200 or ctype != "image/jpeg":
            return None, None
        SHOTS[self.name] = (taken, data)
        return data, taken


def poll(units, wait=4.0):
    """Every unit's brief status at once: {name: (status or None, error)}. Waits at most `wait` s in all, so a unit
    that is down never holds up the page; a slow answer still lands in SEEN for the next look."""
    for name, u in units.items():
        if name not in BUSY or BUSY[name].done():  # one fetch per unit at a time, however often the page loads
            BUSY[name] = POOL.submit(Remote(name, u).status, True, 20)
    jobs = {name: BUSY[name] for name in units}
    concurrent.futures.wait(jobs.values(), timeout=wait)
    out = {}
    for name, job in jobs.items():
        if not job.done():
            out[name] = None, "No answer yet"
        elif job.exception():
            out[name] = None, str(job.exception())
        else:
            out[name] = job.result(), ""
    return out


def badge(s):
    """(level, label) for a unit on the fleet page: as the badge on its TV says it, or Unreachable."""
    if s is None:
        return "bad", "Unreachable"
    state, code, board = s.get("state"), s.get("code") or "", s.get("host")
    if state == "ready":
        return "live", "Live"
    if state == "network" or (state in ("waiting", "folder") and board and code in ("", "000")):
        return "bad", "Offline"
    if state in ("waiting", "folder") and board:
        return "warn", "Cached"
    if state == "folder":
        return "live", "Local Content"
    return "warn", STATES.get(state, state or "Unknown")


def ago(t, now=None):
    secs = int((now or time.time()) - t)
    return "Just now" if secs < 60 else f"{duration(secs)} ago"


def claimed():
    return os.path.exists(os.path.join(STATE, "password"))


CLAIM_LOCK = threading.Lock()


def claim_code():
    """The current claim code, made when needed (at start, or after a reset without a restart)."""
    with CLAIM_LOCK:
        path = os.path.join(RUN, "claim")
        code = (read_file(path) or "").strip()
        if not code and not claimed():
            code = new_code()
            write_file(path, code + "\n", 0o600 if FLEET else 0o644)  # on a unit the splash (kiosk user) shows it
        return code


def claim(code, password, repeat):
    """Set the first password with the claim code: an error, or None."""
    with CLAIM_LOCK:
        if claimed():
            return "Already claimed"
        if not code_matches(code, (read_file(os.path.join(RUN, "claim")) or "").strip()):
            return "Wrong claim code"
        if len(password) < MIN_PASSWORD:
            return f"Use at least {MIN_PASSWORD} characters"
        if password != repeat:
            return "The passwords don't match"
        write_file(os.path.join(STATE, "password"), hash_password(password) + "\n")
        try:
            os.remove(os.path.join(RUN, "claim"))
        except OSError:
            pass
    return None


