# Passwords, tokens and claim codes

def hash_password(password, iterations=ITERATIONS):
    salt = secrets.token_bytes(16)
    key = hashlib.pbkdf2_hmac("sha256", password.encode(), salt, iterations)
    return f"pbkdf2_sha256${iterations}${base64.b64encode(salt).decode()}${base64.b64encode(key).decode()}"


def check_password(password, stored):
    try:
        algo, n, salt, key = stored.strip().split("$")
        got = hashlib.pbkdf2_hmac("sha256", password.encode(), base64.b64decode(salt), int(n))
        return algo == "pbkdf2_sha256" and hmac.compare_digest(got, base64.b64decode(key))
    except (ValueError, TypeError, AttributeError):
        return False


def new_code():
    c = "".join(secrets.choice(CODE_CHARS) for _ in range(6))
    return f"{c[:3]}-{c[3:]}"  # eg K7M-4QX


def code_matches(given, code):
    norm = lambda s: re.sub(r"[^A-Z0-9]", "", s.upper())
    return bool(code) and hmac.compare_digest(norm(given), norm(code))


def token_hash(token):
    return hashlib.sha256(token.encode()).hexdigest()  # tokens are random 256-bit: no need for a slow hash


def read_file(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return None


def write_file(path, text, mode=0o600):
    """Beside, flushed, then renamed: a power cut leaves the old file or the new one."""
    tmp = f"{path}.tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    with os.fdopen(fd, "w") as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    os.chmod(tmp, mode)  # whatever the umask
    os.replace(tmp, path)


class Tokens:
    """API tokens by name, stored as SHA-256 only. The token itself is shown once, when made."""

    def __init__(self, path):
        self.path, self.lock = path, threading.Lock()

    def load(self):
        try:
            return json.loads(read_file(self.path) or "{}")
        except ValueError:
            return {}

    def list(self):
        return [{"name": n, "created": t.get("created", "")} for n, t in sorted(self.load().items())]

    def create(self, name):
        name = (name or "").strip()
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9 ._-]{0,39}", name):
            raise ValueError("Name is 1 to 40 letters, digits, spaces, dots, dashes or underscores")
        with self.lock:
            tokens = self.load()
            if name in tokens:
                raise ValueError(f"A token named {name} already exists")
            token = "tvl_" + secrets.token_urlsafe(32)
            tokens[name] = {"sha256": token_hash(token), "created": time.strftime("%Y-%m-%d %H:%M")}
            write_file(self.path, json.dumps(tokens, indent=1))
        return token

    def revoke(self, name):
        with self.lock:
            tokens = self.load()
            if tokens.pop(name, None) is None:
                return False
            write_file(self.path, json.dumps(tokens, indent=1))
            return True

    def check(self, token):
        """The token's name, or None."""
        if not token:
            return None
        h = token_hash(token)
        found = None
        for name, t in self.load().items():  # compare with every one, in constant time
            if hmac.compare_digest(h, t.get("sha256", "")):
                found = name
        return found


class Sessions:
    """In memory. Anonymous ones (auth False) carry the CSRF token of the login and claim forms."""

    def __init__(self):
        self.data, self.lock = {}, threading.Lock()

    def new(self, auth=False):
        sid, now = secrets.token_urlsafe(32), time.time()
        with self.lock:
            self.data = {k: v for k, v in self.data.items() if v["expires"] > now}
            anon = sorted((v["expires"], k) for k, v in self.data.items() if not v["auth"])
            for _, k in anon[:max(0, len(anon) - MAX_ANON + 1)]:  # a flood of form loads can't fill memory
                del self.data[k]
            self.data[sid] = {"auth": auth, "csrf": secrets.token_urlsafe(32), "flash": "",
                              "expires": now + (SESSION_TTL if auth else ANON_TTL)}
        return sid

    def get(self, sid):
        with self.lock:
            s = self.data.get(sid or "")
            return s if s and s["expires"] > time.time() else None

    def drop(self, sid):
        with self.lock:
            self.data.pop(sid or "", None)


class Limiter:
    """Failed tries per client in a sliding window, plus a cap across all clients."""

    def __init__(self, tries=TRIES, window=WINDOW):
        self.tries, self.window, self.fails, self.lock = tries, window, {}, threading.Lock()

    def _recent(self, key, now):
        self.fails[key] = [t for t in self.fails.get(key, []) if now - t < self.window]
        return self.fails[key]

    def blocked(self, ip, now=None):
        now = now or time.monotonic()
        with self.lock:
            return len(self._recent(ip, now)) >= self.tries or len(self._recent("*", now)) >= 4 * self.tries

    def fail(self, ip, now=None):
        now = now or time.monotonic()
        with self.lock:
            self._recent(ip, now).append(now)
            self._recent("*", now).append(now)


# The unit, through tvlink

def tvlink(*args, root=True, timeout=90):
    """(ok, stdout, stderr). A list of arguments, never a shell; root through sudo's fixed list."""
    cmd = ([SUDO, "-n", CLI] if root else [CLI]) + list(args)
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, errors="replace", timeout=timeout,
                           stdin=subprocess.DEVNULL)
        return p.returncode == 0, p.stdout.strip(), p.stderr.strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        return False, "", str(e)


def schema():
    """{"version", "keys": [...]} from `tvlink keys --json`."""
    ok, out, err = tvlink("keys", "--json", root=False)
    try:
        return json.loads(out)
    except ValueError:
        return {"version": "", "keys": [], "error": err or "Can't read the settings"}


def save(changes):
    """Set {KEY: value} with one `tvlink set`: (ok, message, key the message is about)."""
    if not changes:
        return True, "Nothing changed", None
    for k, v in changes.items():
        if not re.fullmatch(r"[A-Z][A-Z0-9_]*", k) or not isinstance(v, str):
            return False, f"Unknown setting: {k}", None
    ok, out, err = tvlink("set", *(f"{k}={v}" for k, v in changes.items()), timeout=300)  # a first tunnel: apt
    if ok:
        return True, "Saved", None
    msg = err or out or "Can't save"
    return False, msg, error_key(msg, changes)


def error_key(msg, keys):
    return next((k for k in keys if re.search(rf"(?<![A-Z0-9_]){k}(?![A-Z0-9_])", msg)), None)


def read_status(path=STATUS):
    try:
        with open(path, errors="replace") as f:
            text = f.read().strip()
        return json.loads(text[text.index("(") + 1:text.rindex(")")])
    except (OSError, ValueError):
        return {}


def screen():
    """(JPEG bytes, mtime) of the last screenshot, or (None, None). Never through a link: the folder is the kiosk's."""
    try:
        fd = os.open(SCREEN, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return None, None
    with os.fdopen(fd, "rb") as f:
        st = os.fstat(f.fileno())
        if not stat.S_ISREG(st.st_mode):
            return None, None
        return f.read(16 * 2**20), st.st_mtime


def uptime():
    try:
        with open("/proc/uptime") as f:
            secs = int(float(f.read().split()[0]))
    except (OSError, ValueError, IndexError):
        return 0
    return secs


def duration(secs):
    d, h, m = secs // 86400, secs // 3600 % 24, secs // 60 % 60
    return f"{d} d {h} h" if d else f"{h} h {m} min" if h else f"{m} min"


def status(brief=False):
    """The unit's state; brief: without doctor's health lines, which can take seconds (the fleet page)."""
    s = read_status()
    _, tv, _ = tvlink("status", timeout=30)
    _, tunnel, _ = tvlink("tunnel", root=False, timeout=10)
    _, doctor, err = (True, "", "") if brief else tvlink("doctor", timeout=60)
    _, shot = screen()
    label = STATES.get(s.get("state", ""), s.get("state", "") or "Unknown")
    if s.get("code") and s.get("code") != "000" and s.get("state") in ("waiting", "folder"):
        label += f" (HTTP {s['code']})"
    return {"name": s.get("name") or socket.gethostname(), "ip": s.get("ip", ""), "version": schema().get("version"),
            "state": s.get("state", ""), "screen": label, "code": s.get("code", ""), "host": s.get("host", ""),
            "tv": tv or "unknown", "tunnel": tunnel or "unknown", "uptime": uptime(),
            "health": (doctor or err).splitlines(), "screenshot": int(shot) if shot else None}


def networks():
    """Visible Wi-Fi networks, strongest first: [{ssid, signal, security}]. From the last scan: no root needed."""
    try:
        out = subprocess.run(["nmcli", "-g", "SIGNAL,SECURITY,SSID", "device", "wifi", "list", "--rescan", "no"],
                             capture_output=True, text=True, errors="replace", timeout=20).stdout
    except (OSError, subprocess.TimeoutExpired):
        return []
    best = {}
    for line in out.splitlines():
        try:
            signal, security, ssid = line.split(":", 2)  # SSID last: only it can hold an (escaped) colon
            ssid = re.sub(r"\\(.)", r"\1", ssid)
            if ssid and int(signal) > best.get(ssid, {}).get("signal", -1):
                best[ssid] = {"ssid": ssid, "signal": int(signal), "security": security or "Open"}
        except ValueError:
            pass
    return sorted(best.values(), key=lambda n: -n["signal"])


def logs(which=LOGS):
    return {w: (lambda r: r[1] or r[2])(tvlink("logs", w)) for w in which}


def action(name):
    """(ok, message) of one of ACTIONS."""
    ok, out, err = tvlink(name, timeout=60)
    return ok, out or err or ("Done" if ok else "Failed")


def update(url, sha256):
    ok, out, err = tvlink("update", url, sha256, timeout=330)
    return ok, out or err or "Failed"


