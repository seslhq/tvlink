"""


def csrf_input(sess):
    return f'<input type="hidden" name="csrf" value="{e(sess["csrf"])}">'


def field(k, value=None, error=""):
    """One settings input from the schema; value: what was just posted, to show it again with its error."""
    key, kind = k["key"], k["type"]
    value = k.get("value", "") if value is None else value
    attrs = f'name="{e(key)}" id="{e(key)}"' + (f' aria-invalid="true" aria-describedby="{e(key)}-error"'
                                                  if error else "")
    if kind == "choice":
        options = list(k.get("choices", []))
        if value not in options:
            options.insert(0, value)
        opts = "".join(f'<option{" selected" if c == value else ""}>{e(c)}</option>' for c in options)
        inp = f"<select {attrs}>{opts}</select>"
    elif kind == "secret":  # write-only: never sent to the browser
        inp = (f'<input type="password" {attrs} autocomplete="new-password" '
               f'placeholder="{"(set)" if k.get("set") else "(not set)"}">')
        if k.get("set"):
            inp += f'<label class="check"><input type="checkbox" name="clear_{e(key)}"> Clear</label>'
    else:
        mode = {"number": ' inputmode="numeric"', "url": ' inputmode="url"', "time": ' placeholder="HH:MM"'}
        lst = ' list="ssids"' if key.endswith("_SSID") else ""
        inp = f'<input type="text" {attrs} value="{e(value)}"{mode.get(kind, "")}{lst} autocomplete="off">'
    hint = k.get("hint", "") + (f' Default: {k["default"]}.' if k.get("default") and kind != "secret" else "")
    err = f'<p class="error" id="{e(key)}-error">{e(error)}</p>' if error else ""
    return (f'<div class="field"><label for="{e(key)}">{e(k["label"])}</label>{inp}{err}'
            f'<p class="hint">{e(hint)}</p></div>')


def form_changes(keys, form):
    """Changed values from a settings form: blank secrets are left alone unless Clear is ticked."""
    changes = {}
    for k in keys:
        key = k["key"]
        if k["type"] == "secret":
            if form.get(key):
                changes[key] = form[key]
            elif form.get(f"clear_{key}"):
                changes[key] = ""
        elif key in form and form[key] != k.get("value", ""):
            changes[key] = form[key]
    return changes


def settings_form(keys, sess, action, form=None, error="", error_at=None, extra=""):
    form = form or {}
    fields = "".join(field(k, form.get(k["key"]) if k["type"] != "secret" else None,
                           error if k["key"] == error_at else "") for k in keys)
    return (f'<form method="post" action="{action}" class="card">{csrf_input(sess)}{fields}{extra}'
            f'<button>Save</button></form>')


def page_keys(sch, wifi):
    return [k for k in sch.get("keys", []) if k["key"].startswith("WIFI") == wifi]


# HTTP

class Handler(BaseHTTPRequestHandler):
    server_version, sys_version = "tvlink-console", ""
    timeout = 60  # a client that stops sending frees its thread
    sessions, limiter, tokens = Sessions(), Limiter(), Tokens(os.path.join(STATE, "tokens.json"))
    units = Units(os.path.join(STATE, "units.json"))  # fleet mode

    def do_GET(self):
        self.route("GET")

    def do_POST(self):
        self.route("POST")

    def do_DELETE(self):
        self.route("DELETE")

    # Replies

    def reply(self, code, body, ctype="text/html; charset=utf-8", headers=()):
        data = body if isinstance(body, bytes) else body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("Content-Security-Policy",
                         "default-src 'none'; style-src 'self'; img-src 'self'; form-action 'self'; "
                         "frame-ancestors 'none'; base-uri 'none'")
        sess = getattr(self, "sess", None)
        if sess and sess["auth"]:
            self.send_header("X-CSRF-Token", sess["csrf"])  # for API calls made with the session
        for k, v in headers:
            self.send_header(k, v)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(data)

    def json(self, code, obj):
        self.reply(code, json.dumps(obj, indent=1) + "\n", "application/json")

    def redirect(self, to, cookie=None):
        self.reply(303, "", headers=[("Location", to)] + ([("Set-Cookie", cookie)] if cookie else []))

    def page(self, title, body, path="", flash="", bad=False):
        """A whole page. path: where it is, below self.base (in fleet mode /u/NAME for a unit's pages)."""
        nav = ""
        if self.sess and self.sess["auth"]:
            links = "".join(f'<a href="{href}"{" aria-current=page" if href == self.base + path else ""}>{label}</a>'
                            for href, label in self.nav)
            nav = (f'<nav>{links}<form method="post" action="/logout">{csrf_input(self.sess)}'
                   '<button class="quiet">Log Out</button></form></nav>')
        label = e(self.name)
        if FLEET:
            label = '<a href="/">Fleet</a>' + (f" / {label}" if self.base else "")
        flash = f'<div class="flash{" bad" if bad else ""}" role="status">{e(flash)}</div>' if flash else ""
        return (f'<!doctype html><html lang="en"><head><meta charset="utf-8">'
                f'<meta name="viewport" content="width=device-width, initial-scale=1">'
                f'<title>{e(title)} · {e(self.name)}</title><link rel="stylesheet" href="/console.css"></head><body>'
                f'<header><span class="unit">{MARK}{label}</span>{nav}</header>'
                f'<main><h1>{e(title)}</h1>{flash}{body}</main></body></html>')

    def https(self):
        """Whether the browser came over HTTPS, through a tunnel or proxy: only ever for the cookie's Secure flag."""
        visitor = self.headers.get("Cf-Visitor", "").replace(" ", "")  # Cloudflare: {"scheme":"https"}
        return self.headers.get("X-Forwarded-Proto", "").lower() == "https" or '"scheme":"https"' in visitor

    def client_ip(self):
        """The peer, or for a request through cloudflared on this machine, the visitor Cloudflare names: so the login
        limit counts each visitor, not the tunnel. Only from loopback: no one on the network can pick their own."""
        peer = self.client_address[0].removeprefix("::ffff:")
        try:
            if ipaddress.ip_address(peer).is_loopback:
                return str(ipaddress.ip_address(self.headers.get("Cf-Connecting-IP", "").strip()))
        except ValueError:
            pass
        return peer

    def cookie(self, sid):
        secure = "; Secure" if self.https() else ""
        return f"tvlink={sid}; Path=/; HttpOnly; SameSite=Strict{secure}"

    def start_session(self, auth):
        """A new session (a new id after login: no fixation); its cookie."""
        self.sessions.drop(self.sid)
        self.sid = self.sessions.new(auth)
        self.sess = self.sessions.get(self.sid)
        return self.cookie(self.sid)

    def anon(self):
        """The session behind the login and claim forms, made if missing: (session, cookie or None)."""
        if self.sess:
            return None
        return self.start_session(False)

    def flash_back(self, to, msg, bad=False):
        self.sess["flash"] = ("!" if bad else "") + msg
        self.redirect(to)

    def take_flash(self):
        msg, self.sess["flash"] = self.sess["flash"], ""
        return msg.lstrip("!"), msg.startswith("!")

    # Requests

    def body(self):
        n = int(self.headers.get("Content-Length") or 0)
        if n > 65536:
            raise ValueError("Request too large")
        return self.rfile.read(n).decode(errors="replace") if n else ""

    def form(self):
        return {k: v[0] for k, v in parse_qs(self.body(), keep_blank_values=True).items()}

    def route(self, method):
        url = urlsplit(self.path)
        path, query = url.path, {k: v[0] for k, v in parse_qs(url.query).items()}
        jar = SimpleCookie()
        try:
            jar.load(self.headers.get("Cookie", ""))
        except Exception:  # a malformed cookie header is just no session
            pass
        self.sid = jar["tvlink"].value if "tvlink" in jar else None
        self.sess = self.sessions.get(self.sid)
        self.unit, self.base, self.name = LOCAL, "", "Fleet" if FLEET else socket.gethostname()
        self.nav = FLEET_NAV if FLEET else NAV
        try:
            if path == "/console.css":
                return self.reply(200, CSS, "text/css; charset=utf-8")
            if path.startswith("/api/") and not FLEET:
                return self.api(method, path, query)
            return self.pages(method, path)
        except ValueError as err:
            return self.reply(400, str(err), "text/plain; charset=utf-8")
        except UnitError as err:  # fleet mode: the unit did not answer as it should
            return self.reply(502, self.page("Can't Reach the Unit", f"<p>{e(str(err))}</p>"))

    def csrf_ok(self, given):
        return bool(self.sess and given and hmac.compare_digest(str(given), self.sess["csrf"]))

    def pages(self, method, path):
        ip = self.client_ip()
        if method not in ("GET", "POST"):
            return self.reply(405, "Method not allowed", "text/plain")
        if not claimed():
            if path != "/claim":
                return self.redirect("/claim")
            return self.claim_page(method, ip)
        if path == "/claim":
            return self.redirect("/login")
        if path == "/login":
            return self.login_page(method, ip)
        if not (self.sess and self.sess["auth"]):
            return self.redirect("/login")
        form = {}
        if method == "POST":
            form = self.form()
            if not self.csrf_ok(form.get("csrf")):
                return self.reply(403, self.page("Expired Form", '<p>The form expired or came from another site. '
                                                 '<a href="/">Start again</a>.</p>'))
        unit = {"/": self.status_page, "/settings": self.settings_page, "/wifi": self.wifi_page,
                "/actions": self.actions_page, "/logs": self.logs_page, "/update": self.update_page,
                "/screenshot.jpg": self.screenshot}
        if FLEET:  # its own pages, and every unit's pages under /u/NAME, through the unit's API
            handler = {"/": self.fleet_page, "/units": self.units_page, "/units/new": self.unit_new_page}.get(path)
            m = re.fullmatch(r"/u/([^/]+)(/.*)?", path)
            if m and m[1] in (units := self.units.load()):
                if not m[2]:
                    return self.redirect(f"/u/{m[1]}/")
                self.unit, self.base, self.name = Remote(m[1], units[m[1]]), f"/u/{m[1]}", m[1]
                self.nav = [(self.base + href, label) for href, label in NAV if href != "/tokens"]
                handler, path = unit.get(m[2]), m[2]
        else:
            handler = {**unit, "/tokens": self.tokens_page}.get(path)
        handler = self.logout if path == "/logout" and not self.base else handler
        if not handler:
            return self.reply(404, self.page("Not Found", '<p><a href="/">Back</a></p>'))
        return handler(method, form)

    def claim_page(self, method, ip):
        cookie, msg, title = self.anon(), "", "Claim This Console" if FLEET else "Claim This Unit"
        claim_code()
        if method == "POST":
            form = self.form()
            if not self.csrf_ok(form.get("csrf")):
                msg = "The form expired. Try again."
            elif self.limiter.blocked(ip):
                msg = "Too many tries. Wait a few minutes."
            else:
                msg = claim(form.get("code", ""), form.get("password", ""), form.get("repeat", ""))
                if msg is None:
                    return self.redirect("/", self.start_session(True))
                if msg == "Wrong claim code":
                    self.limiter.fail(ip)
        where = (f"the code from <code>sudo cat {e(RUN)}/claim</code> on the fleet server" if FLEET else
                 "the code shown on its TV (or from <code>sudo tvlink console claim</code>)")
        body = (f'<div class="narrow"><p>This {"fleet console" if FLEET else "unit"} has no password yet. Enter '
                f'{where} and choose the console password.</p>'
                f'<form method="post" action="/claim" class="card">{csrf_input(self.sess)}'
                f'<div class="field"><label for="code">Claim Code</label><input id="code" name="code" '
                f'autocomplete="off" autocapitalize="characters" placeholder="ABC-123" required></div>'
                f'<div class="field"><label for="password">New Password</label><input type="password" id="password" '
                f'name="password" autocomplete="new-password" minlength="{MIN_PASSWORD}" required>'
                f'<p class="hint">At least {MIN_PASSWORD} characters.</p></div>'
                f'<div class="field"><label for="repeat">Repeat Password</label><input type="password" id="repeat" '
                f'name="repeat" autocomplete="new-password" required></div><button>{title}</button>'
                f'</form></div>')
        self.reply(400 if msg else 200, self.page(title, body, flash=msg, bad=True),
                   headers=[("Set-Cookie", cookie)] if cookie else [])

    def login_page(self, method, ip):
        if self.sess and self.sess["auth"]:
            return self.redirect("/")
        cookie, msg = self.anon(), ""
        if method == "POST":
            form = self.form()
            if not self.csrf_ok(form.get("csrf")):
                msg = "The form expired. Try again."
            elif self.limiter.blocked(ip):
                msg = "Too many tries. Wait a few minutes."
            elif check_password(form.get("password", ""), read_file(os.path.join(STATE, "password")) or ""):
                return self.redirect("/", self.start_session(True))
            else:
                self.limiter.fail(ip)
                msg = "Wrong password"
        reset = (f"On the fleet server: <code>sudo rm {e(STATE)}/password</code>, restart tvlink-fleet and claim it"
                 " again"
                 if FLEET else "On the unit: <code>sudo tvlink console reset</code>")
        body = (f'<div class="narrow"><form method="post" action="/login" class="card">{csrf_input(self.sess)}'
                f'<div class="field"><label for="password">Password</label><input type="password" id="password" '
                f'name="password" autocomplete="current-password" autofocus required></div>'
                f'<button>Log In</button></form><p class="hint">Forgotten it? {reset}.</p></div>')
        self.reply(401 if msg else 200, self.page("Log In", body, flash=msg, bad=True),
                   headers=[("Set-Cookie", cookie)] if cookie else [])

    def logout(self, method, form):
        if method != "POST":
            return self.redirect("/")
        self.sessions.drop(self.sid)
        self.redirect("/login", "tvlink=; Path=/; Max-Age=0; HttpOnly; SameSite=Strict")

    def screenshot(self, method, form):
        data, _ = self.unit.screen()
        if data is None:
            return self.reply(404, "No screenshot yet", "text/plain")
        self.reply(200, data, "image/jpeg")

    def status_page(self, method, form):
        s = self.unit.status()
        flash, bad = self.take_flash()
        level = "live" if s["state"] == "ready" else "bad" if s["state"] == "network" else ""
        shot = (f'<img src="{self.base}/screenshot.jpg?{s["screenshot"]}" alt="What the TV shows">' if s["screenshot"]
                else '<div class="noshot">No screenshot yet</div>')
        taken = time.strftime("Taken %H:%M:%S", time.localtime(s["screenshot"])) if s["screenshot"] else ""
        rows = [("Screen", f'<span class="pill {level}">{e(s["screen"])}</span>'), ("Board", e(s["host"] or "None")),
                ("TV", e(s["tv"].capitalize())), ("Tunnel", e(s.get("tunnel", "").capitalize())),
                ("Name", e(s["name"])), ("IP", e(s["ip"] or "None")),
                ("Version", e(s["version"] or "")), ("Uptime", duration(s["uptime"]))]
        body = (f'<div class="grid"><figure>{shot}<figcaption><span>{taken}</span>'
                f'<form method="post" action="{self.base}/actions">{csrf_input(self.sess)}<input type="hidden" '
                f'name="back" value="{self.base}/"><button class="quiet" name="action" value="screenshot">'
                f'Take Screenshot</button></form>'
                f'</figcaption></figure><section><dl>'
                + "".join(f"<dt>{k}</dt><dd>{v}</dd>" for k, v in rows)
                + f'</dl></section></div><h2>Health</h2><pre>{e(chr(10).join(s["health"]))}</pre>')
        self.reply(200, self.page("Status", body, "/", flash, bad))

    def settings_page(self, method, form, wifi=False):
        path, title = ("/wifi", "Wi-Fi") if wifi else ("/settings", "Settings")
        sch = self.unit.schema()
        keys = page_keys(sch, wifi)
        flash, bad, error, at = "", False, "", None
        if method == "POST":
            ok, msg, at = self.unit.save(form_changes(keys, form))
            if ok:
                return self.flash_back(self.base + path, msg)
            if at:
                error, flash = msg, "Not saved: see below"
            else:
                flash = msg
            bad = True
        else:
            flash, bad = self.take_flash()
            form = None
        extra, body = "", ""
        if wifi:
            nets = self.unit.networks()
            extra = '<datalist id="ssids">' + "".join(f'<option value="{e(n["ssid"])}">' for n in nets) + "</datalist>"
            rows = "".join(f'<tr><td>{e(n["ssid"])}</td><td>{n["signal"]}%</td><td>{e(n["security"])}</td></tr>'
                           for n in nets) or '<tr><td colspan="3">None seen</td></tr>'
            body = (f'<h2>Visible Networks</h2><section><table><thead><tr><th>Network</th><th>Signal</th>'
                    f'<th>Security</th></tr></thead><tbody>{rows}</tbody></table></section>')
            intro = ("<p>Up to two networks, besides the one set in Imager. Changes apply at once; a unit on Wi-Fi "
                     "may drop off for a moment.</p>")
        else:
            intro = "<p>Saved to tvlink.conf on the SD card; the parts that use a setting restart by themselves.</p>"
        if sch.get("error"):
            flash, bad = sch["error"], True
