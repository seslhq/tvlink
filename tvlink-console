    # API

    def api(self, method, path, query):
        auth = self.headers.get("Authorization", "")
        who = None
        if auth.startswith("Bearer "):
            who = self.tokens.check(auth[7:].strip())
        elif self.sess and self.sess["auth"]:
            who = "session"
            if method != "GET" and not self.csrf_ok(self.headers.get("X-CSRF-Token")):
                return self.json(403, {"error": "Missing or wrong X-CSRF-Token"})
        if not who:
            return self.json(401, {"error": "Log in, or send an API token: Authorization: Bearer TOKEN"})
        data = {}
        if method == "POST":
            try:
                data = json.loads(self.body() or "{}")
            except ValueError:
                return self.json(400, {"error": "Body is not JSON"})
            if not isinstance(data, dict):
                return self.json(400, {"error": "Body is a JSON object"})
        route = (method, path)
        if route == ("GET", "/api/status"):
            return self.json(200, status(brief=query.get("brief") == "1"))
        if route == ("GET", "/api/settings"):
            return self.json(200, schema())
        if route == ("POST", "/api/settings"):
            ok, msg, key = save({str(k): v for k, v in data.items()})
            return self.json(200 if ok else 400, {"ok": True, "message": msg} if ok else {"error": msg, "key": key})
        if route == ("POST", "/api/action"):
            action = data.get("action")
            if action not in ACTIONS:
                return self.json(400, {"error": f"action is one of {', '.join(ACTIONS)}"})
            ok, out, err = tvlink(action, timeout=60)
            return self.json(200 if ok else 500, {"ok": ok, "message": out or err})
        if path == "/api/screenshot" and method in ("GET", "POST"):
            if method == "POST":
                ok, out, err = tvlink("screenshot", timeout=60)
                if not ok:
                    return self.json(500, {"error": err or out})
            data, _ = screen()
            return self.reply(200, data, "image/jpeg") if data else self.json(404, {"error": "No screenshot yet"})
        if route == ("GET", "/api/logs"):
            which = query.get("part", "")
            if which and which not in LOGS:
                return self.json(400, {"error": f"part is one of {', '.join(LOGS)}"})
            return self.json(200, logs((which,) if which else LOGS))
        if route == ("GET", "/api/wifi"):
            return self.json(200, {"networks": networks()})
        if route == ("POST", "/api/update"):
            ok, out, err = tvlink("update", str(data.get("url", "")), str(data.get("sha256", "")), timeout=330)
            return self.json(200 if ok else 400, {"ok": ok, "message": out or err})
        if route == ("GET", "/api/tokens"):
            return self.json(200, {"tokens": self.tokens.list()})
        if route == ("POST", "/api/tokens"):
            try:
                return self.json(200, {"name": str(data.get("name", "")).strip(),
                                       "token": self.tokens.create(str(data.get("name", "")))})
            except ValueError as err:
                return self.json(400, {"error": str(err)})
        if method == "DELETE" and path.startswith("/api/tokens/"):
            name = unquote(path[len("/api/tokens/"):])
            ok = self.tokens.revoke(name)
            return self.json(200 if ok else 404, {"ok": True} if ok else {"error": "No such token"})
        return self.json(404, {"error": "Not found"})


class Server(ThreadingHTTPServer):
    """IPv6 and IPv4 on one socket."""
    address_family, daemon_threads = socket.AF_INET6, True

    def server_bind(self):
        self.socket.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 0)
        super().server_bind()


def main():
    claim_code()
    try:
        server = (Server if ":" in ADDR else ThreadingHTTPServer)((ADDR, PORT), Handler)
    except OSError:  # no IPv6
        if ADDR != "::":
            raise
        server = ThreadingHTTPServer(("", PORT), Handler)
    mode = "claimed" if claimed() else "claim mode"
    print(f"{'Fleet console' if FLEET else 'Console'} on {ADDR} port {PORT}, {mode}", flush=True)
    server.serve_forever()


