                {"url": "https://x.example/?q"}, {"url": "https://x.example:port"}, {"url": "https://x.example/a b"},
                {"token": "short"}, {"token": "tvl_" + "a" * 30 + "\r\nX: y"}, {"access_id": "id.access"},
