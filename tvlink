#!/bin/bash
# tvlink: show the splash until the board answers, run it full screen, turn the TV on and off.
# Usage: tvlink show|doctor|on|off|status|identify|screenshot|reload|reboot|update|set KEY=value...|console claim|reset
#        tvlink ir learn|test on|off, tvlink edid capture|clear, tvlink content sync|status|manifest DIR
#        (services and the console use check, kiosk, browser, net, mode, keys --json, logs, tunnel, usb, lastgood;
#        install.sh boot)
# SPDX-License-Identifier: Apache-2.0
# Copyright 2026 cpwillis (https://github.com/seslhq/tvlink)
VERSION=0.1.0
CONF=${TVLINK_CONF:-/boot/firmware/tvlink.conf}
CONTENT=${TVLINK_CONTENT:-/boot/firmware/tvlink}
# Keys tvlink set may change. UPDATE_DAY is read too; install.sh applies it. CEC is read only as the old switch: CEC=0
# with no POWER_METHOD means none.
KEYS="BOARD_URL SOURCE SLIDE_SECONDS FIT POWER_MODE TV_ON TV_OFF IDLE_MIN MOTION_PIN POWER_METHOD IR_CODES IR_TX_PIN"
KEYS+=" IR_RX_PIN RESOLUTION HDMI_FORCE_HOTPLUG OVERLAY_CORNER WIFI_COUNTRY WIFI1_SSID WIFI1_PSK WIFI2_SSID WIFI2_PSK"
KEYS+=" TUNNEL_TOKEN USB_CONTENT CONTENT_URL CONTENT_SYNC_MIN LAST_GOOD BROWSER_RESTART"
# shellcheck disable=SC2034
WIFI_COUNTRY='' WIFI1_SSID='' WIFI1_PSK='' WIFI2_SSID='' WIFI2_PSK='' TUNNEL_TOKEN=''
# The tunnel's token lives here, root only, never in the conf on the FAT card: it is a key to the unit's console.
TUNNEL=${TVLINK_TUNNEL:-/etc/tvlink/tunnel-token}
TUNNEL_READY=http://127.0.0.1:20241/ready # cloudflared's metrics: 200 once it holds a connection to Cloudflare
IR=${TVLINK_IR:-/var/lib/tvlink/ir}             # learned IR codes, on and off: root only
SIGNAL=${TVLINK_SIGNAL:-/run/tvlink-display}    # on or off: the HDMI signal root last asked for (POWER_METHOD=signal)
BOOT=${TVLINK_BOOT:-/boot/firmware}             # cmdline.txt and config.txt
EDID=${TVLINK_EDID:-/lib/firmware/edid}         # captured EDIDs, tvlink-<connector>.bin
DRM=${TVLINK_DRM:-/sys/class/drm/card*-HDMI-A-*} # connectors tvlink edid capture reads (the VM test widens it)
USB=${TVLINK_USB:-/run/tvlink-usb}              # a USB stick, mounted read-only (USB_CONTENT=1)
SYNC=${TVLINK_SYNC:-/var/lib/tvlink/content}    # synced content (CONTENT_URL): current links to the live set
SYNC_STATE=/run/tvlink-content/state.json       # the last sync's result, from tvlink-content
LAST=${TVLINK_LAST:-/var/lib/tvlink/last.jpg}   # the last good screen (LAST_GOOD=1): root's copy of the kiosk's
# shellcheck disable=SC2034 # defaults; some are only read through ${!k} in show
BOARD_URL='' SOURCE=auto SLIDE_SECONDS=10 FIT=contain POWER_MODE=schedule TV_ON=06:00 TV_OFF=22:00 IDLE_MIN=15
# shellcheck disable=SC2034
MOTION_PIN=17 CEC=1 RESOLUTION=1920x1080@60 UPDATE_DAY='' OVERLAY_CORNER=bottom-right POWER_METHOD=''
# shellcheck disable=SC2034
IR_CODES=learned IR_TX_PIN=18 IR_RX_PIN=23 HDMI_FORCE_HOTPLUG=0
# shellcheck disable=SC2034
USB_CONTENT=0 CONTENT_URL='' CONTENT_SYNC_MIN=15 LAST_GOOD=0 BROWSER_RESTART=''
for k in $KEYS; do printf -v "DEF_$k" %s "${!k}"; done # defaults, for tvlink keys
# shellcheck disable=SC2034 # read through ${!d} in keys
DEF_POWER_METHOD=cec
IR_BRANDS="lg samsung sony toshiba" # built-in discrete codes: ir_table
# Settings schema for tvlink keys (the console's forms): KEY|type|label|hint. A type with spaces is a list of
# choices; a key without a line here shows as text.
SPEC='
BOARD_URL|url|Board URL|Page to show full screen. Blank: local content only.
SOURCE|auto folder|Source|auto: the page, else local content. folder: local content only.
SLIDE_SECONDS|number|Slide Seconds|Seconds per image in local content.
FIT|contain cover|Fit|contain: the whole image. cover: fill the screen, crop the edges.
POWER_MODE|always schedule motion manual manual+motion|Power Mode|How the TV is turned on and off.
TV_ON|time|TV On|Start of on-hours, HH:MM local time. Blank: always on.
TV_OFF|time|TV Off|End of on-hours. Earlier than TV On runs past midnight.
IDLE_MIN|number|Idle Minutes|Motion modes: quiet minutes before standby or the next wake.
MOTION_PIN|number|Motion Pin|GPIO (BCM number) wired to the motion sensor.
POWER_METHOD|cec ir signal none|Power Method|How the Pi turns the TV on and off. cec: HDMI-CEC. ir: infrared codes. \
signal: the HDMI signal off and on. none: never touch the TV.
IR_CODES|BRANDS learned|IR Codes|Built-in power codes for a TV brand, or learned: recorded with tvlink ir learn.
IR_TX_PIN|number|IR Transmitter Pin|GPIO (BCM number) driving the IR LED. A change needs a reboot.
IR_RX_PIN|number|IR Receiver Pin|GPIO (BCM number) of the IR receiver, to learn codes. Blank: none. Reboot to apply.
RESOLUTION|text|Resolution|HDMI mode, eg 1920x1080@60. auto: the mode the TV prefers.
HDMI_FORCE_HOTPLUG|0 1|Force HDMI Hotplug|1: HDMI0 stays connected while the TV is off or on another input. Reboot \
to apply.
OVERLAY_CORNER|bottom-right bottom-left top-right top-left off|Badge Corner|Corner of the status badge.
WIFI_COUNTRY|text|Wi-Fi Country|Two-letter code, eg AU. Blank keeps the one set in Imager.
WIFI1_SSID|text|Network 1|Wi-Fi network name. Hidden networks work.
WIFI1_PSK|secret|Password 1|Blank: an open network.
WIFI2_SSID|text|Network 2|A second network, eg the next one when the site changes its Wi-Fi.
WIFI2_PSK|secret|Password 2|Blank: an open network.
TUNNEL_TOKEN|secret|Tunnel Token|Cloudflare Tunnel token for this unit. Kept on the unit, not the SD card. Clear: off.
USB_CONTENT|0 1|USB Content|1: a USB stick with a tvlink folder plays like local content, ahead of the rest.
CONTENT_URL|url|Content URL|https link to a manifest of files to sync and play as local content. Blank: off.
CONTENT_SYNC_MIN|number|Content Sync Minutes|Minutes between syncs of Content URL.
LAST_GOOD|0 1|Last Good Screen|1: keep an hourly screenshot of the live page, shown marked Offline at a start with no \
network and no local content.
BROWSER_RESTART|time|Browser Restart|Restart the browser daily at HH:MM, eg 04:00. Blank: never.
'
SPEC=${SPEC//$'\\\n'/} SPEC=${SPEC/|BRANDS /|$IR_BRANDS } # lines ending in \ go on; the built-in brands

die() { echo "$*" >&2; exit 1; }

# From the console, sudo starts us inside its sandbox (read-only system, private /tmp): rerun in a fresh unit, as from
# a root shell. A fixed description: the command line can hold secrets, and the unit's would be logged.
[ "${SUDO_USER:-}" != tvlink-console ] || [ "$(id -u)" != 0 ] ||
  exec systemd-run --quiet --pipe --wait --collect --service-type=exec --description="tvlink for the console" "$0" "$@"

# Known keys only; the conf is never run. Value: text after =, trimmed. A quoted value runs to the last matching
# quote, else a space before # starts a note. CRLF and a missing final newline are fine; a later line wins.
read_conf() {
  local line k v q
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'} && line=${line#$'\xef\xbb\xbf'} # CRLF, and the UTF-8 BOM some editors put first
    [[ $line == *=* ]] || continue
    k=${line%%=*} v=${line#*=}
    k=${k//[[:space:]]/}
    [[ " $KEYS UPDATE_DAY CEC " == *" $k "* && $k != TUNNEL_TOKEN ]] || continue
    v=${v#"${v%%[![:space:]]*}"}
    q=${v:0:1}
    if [[ ($q == \" || $q == \') && ${v:1} == *"$q"* ]]; then
      v=${v:1} && v=${v%"$q"*}
    else
      v=${v%%[[:space:]]#*} && v=${v%"${v##*[![:space:]]}"}
      [[ $v != \#* ]] || v='' # KEY=   # note: the value is blank, not the note
    fi
    printf -v "$k" %s "$v"
  done <"$CONF"
}
[ -r "$CONF" ] && read_conf
# shellcheck disable=SC2034 # read through ${!k}; whether it is set: anyone may know that, only root reads it
[ ! -s "$TUNNEL" ] || TUNNEL_TOKEN='(set)'
check_conf() {
  # A bad hand edit falls back to the default instead of breaking the screen; tvlink set refuses the same values.
  [[ -z $BOARD_URL || $BOARD_URL =~ ^https?://[^[:space:]]+$ ]] ||
    { echo "BOARD_URL ignored: not an http(s) link" >&2; BOARD_URL=''; }
  [[ $SLIDE_SECONDS =~ ^[1-9][0-9]{0,4}$ ]] || SLIDE_SECONDS=10
  [[ $CEC =~ ^[01]$ ]] || CEC=1
  [[ $POWER_METHOD =~ ^(cec|ir|signal|none)$ ]] || { POWER_METHOD=cec; [ "$CEC" = 1 ] || POWER_METHOD=none; }
  [[ " $IR_BRANDS learned " == *" $IR_CODES "* ]] || IR_CODES=learned
  [[ $IR_TX_PIN =~ ^([2-9]|1[0-9]|2[0-7])$ ]] || IR_TX_PIN=18 # BCM 2 to 27: the header's GPIOs
  [[ $IR_RX_PIN =~ ^([2-9]|1[0-9]|2[0-7])?$ ]] || IR_RX_PIN=23
  [[ $HDMI_FORCE_HOTPLUG =~ ^[01]$ ]] || HDMI_FORCE_HOTPLUG=0
  [[ $RESOLUTION =~ ^([0-9]+x[0-9]+(@[0-9]+)?|auto)$ ]] || RESOLUTION=1920x1080@60
  [[ $UPDATE_DAY =~ ^(Mon|Tue|Wed|Thu|Fri|Sat|Sun)?$ ]] ||
    { echo "UPDATE_DAY ignored: not a day, eg Wed" >&2; UPDATE_DAY=''; }
  [[ $OVERLAY_CORNER =~ ^((top|bottom)-(left|right)|off)$ ]] || OVERLAY_CORNER=bottom-right
  [[ $USB_CONTENT =~ ^[01]$ ]] || USB_CONTENT=0
  [[ -z $CONTENT_URL || $CONTENT_URL =~ ^https://[^[:space:]]+$ ]] ||
    { echo "CONTENT_URL ignored: not an https link" >&2; CONTENT_URL=''; }
  [[ $CONTENT_SYNC_MIN =~ ^[1-9][0-9]{0,3}$ ]] || CONTENT_SYNC_MIN=15
  [[ $LAST_GOOD =~ ^[01]$ ]] || LAST_GOOD=0
  [[ $BROWSER_RESTART =~ ^(([01][0-9]|2[0-3]):[0-5][0-9])?$ ]] || BROWSER_RESTART=''
}
check_conf

# Settings as tvlink uses them, for tvlink-power, install.sh and people.
show() {
  local k
  echo "VERSION=$VERSION"
  for k in $KEYS UPDATE_DAY; do
    if [[ $k == *_PSK && -n ${!k} ]]; then echo "$k=(set)"; else printf '%s=%s\n' "$k" "${!k}"; fi
  done
}

# One probe: BOARD_URL answers below 500. Sets code.
board_up() { code=$(curl -sS -o /dev/null -I -m 10 -w '%{http_code}' "$BOARD_URL") && [ "$code" -lt 500 ]; }

# A JSON string: quotes, backslashes and tabs escaped, other control characters dropped.
js() { local s=${1//\\/\\\\}; s=${s//\"/\\\"} && s=${s//$'\t'/\\t} && printf '"%s"' "${s//[[:cntrl:]]/}"; }

# The settings schema with current values and defaults, as JSON for the console. Secrets give only whether they are set.
keys() {
  local k v t label hint spec c sep='' cs d
  [ "${1:-}" = --json ] || die "Usage: tvlink keys --json"
  printf '{"version":%s,"keys":[' "$(js "$VERSION")"
  for k in $KEYS; do
    spec=${SPEC#*$'\n'"$k|"} && spec=${spec%%$'\n'*}
    [ "$spec" != "$SPEC" ] || spec="text|$k|"
    IFS='|' read -r t label hint <<<"$spec"
    v=${!k} d=DEF_$k cs=''
    if [[ $t == *' '* ]]; then
      for c in $t; do cs+="${cs:+,}$(js "$c")"; done
      t=choice
    fi
    if [ "$t" = secret ]; then v='' && cs="\"set\":$([ -n "${!k}" ] && echo true || echo false)"
    elif [ "$t" = choice ]; then cs="\"choices\":[$cs]"
    fi
    printf '%s{"key":"%s","type":"%s","label":%s,"hint":%s,"value":%s,"default":%s%s}' "$sep" "$k" "$t" \
      "$(js "$label")" "$(js "$hint")" "$(js "$v")" "$(js "${!d}")" "${cs:+,$cs}"
    sep=,
  done
  printf ']}\n'
}

# Splash state as JSONP for splash.html, written then renamed so it is never read half done. It carries the full URL
# to navigate to; the splash only ever shows the host.
STATUS=${TVLINK_STATUS:-/run/tvlink/status.js}
CLAIM=${TVLINK_CLAIM:-/run/tvlink-console/claim} # the console's claim code, there until a password is set
put_status() { # state [http code] [files json] [source]
  local host=${BOARD_URL#*://} url=${BOARD_URL//\\/\\\\} claim='' last=0
  read -r claim 2>/dev/null <"$CLAIM"
  [ "$LAST_GOOD" != 1 ] || last=$(stat -c %Y "$LAST" 2>/dev/null) || last=0
  host=${host%%[/?#]*} host=${host##*@} url=${url//\"/\\\"}
  printf 'tvlink({"state":"%s","code":"%s","host":"%s","url":"%s","name":"%s","ip":"%s","version":"%s",' \
    "$1" "${2:-}" "${host//[\"\\]/}" "$url" "$(hostname)" "$(hostname -I 2>/dev/null | cut -d' ' -f1)" "$VERSION" \
    >"$STATUS.tmp" &&
    printf '"files":[%s],"source":"%s","secs":%d,"fit":"%s","claim":"%s","last":%d,"corner":"%s"})\n' "${3:-}" \
      "${4:-}" "$SLIDE_SECONDS" "${FIT//[^a-z]/}" "${claim//[^A-Z0-9-]/}" "$last" "${OVERLAY_CORNER//[^a-z-]/}" \
      >>"$STATUS.tmp" &&
    mv "$STATUS.tmp" "$STATUS"
}

# Local content: images, videos or index.html in the first folder that has any: a USB stick's tvlink folder
# (USB_CONTENT=1), synced content (CONTENT_URL), then the SD card's. Two lines: where from (usb, synced or card, blank
# if none) and the files as a JSON list, by name. Skips dotfiles (eg macOS ._ copies).
content() {
  local src dir f out=''
  for src in usb synced card; do
    case $src in
      usb) [ "$USB_CONTENT" = 1 ] || continue; dir=$USB/tvlink ;;
      synced) [ -n "$CONTENT_URL" ] || continue; dir=$(readlink -e "$SYNC/current") || continue ;; # the set itself
      card) dir=$CONTENT ;;
    esac
    while IFS= read -r f; do
      [[ $f == *[[:cntrl:]]* ]] && continue
      f=${f//\\/\\\\} && out+="${out:+,}\"${f//\"/\\\"}\""
    done < <(find "$dir" -maxdepth 1 -type f ! -name '.*' \( -iname '*.jpg' -o -iname '*.jpeg' \
      -o -iname '*.png' -o -iname '*.webp' -o -iname '*.gif' -o -iname '*.svg' -o -iname '*.mp4' -o -iname '*.webm' \
      -o -iname index.html \) 2>/dev/null | LC_ALL=C sort)
    [ -z "$out" ] || break
  done
  printf '%s\n%s\n' "${out:+$src}" "$out"
}

# Feed the splash: hand over to the board only after a probe answers below 500 (never a browser error page); local
# content while it does not, or with SOURCE=folder; else what it waits for. Rescans the folders every 2 s, so new
# files show and a stick pulled out stops playing; rereads the settings too, so a new BOARD_URL needs no restart.
status_loop() {
  local delay=2 src files state last='' seen=0 url now t
  while :; do
    { read -r src; read -r files; } < <(content)
    if [ "$SOURCE" != folder ] && [ -n "$BOARD_URL" ] && board_up; then state=ready code='' seen=1
    elif [ -n "$files" ]; then state=folder # code kept: the badge tells a server error from no network
    elif [ "$SOURCE" = folder ]; then state=empty code=''
    elif [ -z "$BOARD_URL" ]; then state=setup code=''
    elif [ -z "$(ip -4 route show default 2>/dev/null)" ]; then state=network code=''
    else state=waiting
    fi
    put_status "$state" "$code" "$files" "$src"
    if [ "$state $code" != "$last" ]; then echo "Splash: $state $code"; last="$state $code"; fi
    url=$BOARD_URL now=$src$'\n'$files
    for ((t = 0; t < delay; t += 2)); do
      sleep 2
      [ -r "$CONF" ] && read_conf 2>/dev/null
      check_conf 2>/dev/null
      [ "$BOARD_URL" = "$url" ] || { seen=0 delay=1; break; } # a new link: probe it now
      [ "$(content)" = "$now" ] || break
    done
    # Once the board has answered, keep probing every minute: the badge and any return to the splash use it.
    delay=$((seen ? 60 : delay * 2 > 30 ? 30 : delay * 2))
  done
}

# cage shows one app full screen, never blanks, and hides the cursor while no mouse is attached.
kiosk() {
  status_loop &
  exec cage -- "$0" browser
}

# Set each output to RESOLUTION unless it already is; quiet: only say so when it changes something. With
# POWER_METHOD=signal, first the HDMI signal as root last asked for (tvlink on or off): outputs off, or back on.
set_mode() {
  local out outs mode=$RESOLUTION rate='' sig=on heads
  [[ $mode != *@* ]] || { mode+=Hz && rate=${RESOLUTION#*@}; }
  command -v wlr-randr >/dev/null && heads=$(wlr-randr) || return 0
  [ "$POWER_METHOD" != signal ] || [ "$(head -c 3 "$SIGNAL" 2>/dev/null)" != off ] || sig=off
  outs=$(awk '/^[^ ]/ {print $1}' <<<"$heads")
  for out in $outs; do
    if awk -v o="$out" '/^[^ ]/ {on = $1 == o} on && /Enabled: no/ {f = 1} END {exit !f}' <<<"$heads"; then
      [ "$sig" = off ] && continue
      wlr-randr --output "$out" --on && echo "HDMI signal on ($out)"
    elif [ "$sig" = off ]; then
      wlr-randr --output "$out" --off && echo "HDMI signal off ($out)"
      continue
    fi
    [ "$RESOLUTION" != auto ] || continue
    # Already at this size and (rounded) rate: leave it, so a 59.94 Hz TV is not reset every pass.
    wlr-randr | awk -v o="$out" -v m="${RESOLUTION%@*}" -v r="$rate" '/^[^ ]/ {on = $1 == o}
      on && /current/ && $1 == m && (r == "" || int($3 + 0.5) == r) {f = 1} END {exit !f}' && continue
    if wlr-randr --output "$out" --mode "$mode"; then
      [ -z "${1:-}" ] || echo "Set $out back to $mode"
    elif [ -z "${1:-}" ]; then
      echo "Can't set $out to $mode: keeping the TV's mode" >&2
    fi
  done
}

# Inside cage: set the output mode (cage takes the TV's preferred mode, eg 4K, and ignores video=), then hand over to
# tvlink-agent, which runs Chromium. If the TV or cage refuses the mode, the TV's own mode stays and the log says so.
browser() {
  local browser
  browser=$(command -v chromium || command -v chromium-browser) || die "Chromium not installed"
  # tvlink-agent repeats it every 30 s: a TV that drops hotplug in standby comes back at its own mode. The outputs stay
  # on for now even with the signal off: Chromium makes no page without one. The agent's first pass turns them off.
  SIGNAL=/dev/null set_mode
  # Profile, crash reports and Mesa's shader cache in RAM (HOME is the service's runtime dir, emptied every start). No
  # component downloads (Widevine, models, lists): some 90 MB at every start, which fills /run (10% of RAM) and
  # breaks the network.
  exec "${0%/*}/tvlink-agent" "$browser" --kiosk --incognito --noerrdialogs --no-first-run --password-store=basic \
    --ozone-platform=wayland --user-data-dir=/run/tvlink/chromium --hide-scrollbars --disable-component-update \
    --disable-features=Translate,OverscrollHistoryNavigation file:///usr/share/tvlink/splash.html
}

# CEC adapters to use; fails with a note when the method is not CEC or none are present.
cec_devs() {
  [ "$POWER_METHOD" = cec ] || { echo "POWER_METHOD=$POWER_METHOD, skipping" >&2; return 1; }
  compgen -G '/dev/cec*' || { echo "No CEC adapter, skipping" >&2; return 1; }
}

# One CEC message; true only when the TV took it. cec-ctl exits 0 either way, so read its report: a Sequence line
# (sent) and no Tx or Rx error line under it.
cec_send() { cec-ctl "$@" 2>&1 | awk '/Sequence:/ {s = 1} /^\t[TR]x/ {f = 1} END {exit !(s && !f)}'; }

# on: wake a TV that does not report on, then claim its input. off: standby. A TV that dropped hotplug in standby
# leaves the adapter with no address: cec-ctl then sends from Unregistered (15), and only Image View On gets through.
tv_cec() {
  local devs dev pa
  devs=$(cec_devs) || return 0
  for dev in $devs; do
    cec-ctl -d "$dev" --playback >/dev/null 2>&1
    if [ "$1" = off ]; then
      if cec_send -d "$dev" --to 0 --standby; then echo "$dev: standby sent"; else echo "$dev: no answer"; fi
    elif cec-ctl -d "$dev" --to 0 --give-device-power-status 2>/dev/null | grep -qE 'pwr-state: (to-)?on'; then
      echo "$dev: TV already on"
    elif cec_send -d "$dev" --to 0 --image-view-on; then
      pa=$(cec-ctl -d "$dev" | awk '/Physical Address/ {print $NF; exit}')
      cec-ctl -d "$dev" --to 15 --active-source phys-addr="$pa" >/dev/null 2>&1
      echo "$dev: TV woken"
    else
      echo "$dev: no answer"
    fi
  done
}

# TV power by POWER_METHOD. tvlink-power is the only caller that runs on its own; it and people use tvlink on|off.
tv() {
  case $POWER_METHOD in
    cec) tv_cec "$1" ;;
    ir) ir_send "$1" ;;
    signal) signal "$1" ;;
    *) echo "POWER_METHOD=none, skipping" >&2 ;;
  esac
}

# signal: on or off, as last asked for (the TV can't say). CEC: on, standby or unknown, from the first adapter that
# answers. IR and none: unknown.
status() {
  local devs dev state
  if [ "$POWER_METHOD" = signal ]; then
    [ "$(head -c 3 "$SIGNAL" 2>/dev/null)" = off ] && echo off || echo on
    return
  fi
  devs=$(cec_devs 2>/dev/null) || { echo unknown; return; }
  for dev in $devs; do
    cec-ctl -d "$dev" --playback >/dev/null 2>&1 || continue
    state=$(cec-ctl -d "$dev" --to 0 --give-device-power-status 2>/dev/null | awk '/pwr-state:/ {print $2; exit}')
    case $state in
      on | to-on) echo on; return ;;
      standby | to-standby) echo standby; return ;;
    esac
  done
  echo unknown
}

# The HDMI signal off or on, for a TV that sleeps without one and wakes with it. Root keeps the word, outside the
# kiosk's reach; the kiosk applies it (tvlink mode): at once on a request, every 30 s and at every start, so it holds.
signal() {
  [ "$(id -u)" = 0 ] || die "Run as root: sudo tvlink $1"
  { echo "$1" >"$SIGNAL.tmp" && mv -f "$SIGNAL.tmp" "$SIGNAL"; } || die "Can't write $SIGNAL"
  if (ask "display $1") 2>/dev/null; then echo "HDMI signal $1"; else echo "HDMI signal $1 once the kiosk runs"; fi
}

# Discrete power on and off codes per brand, as ir-ctl -S takes them (protocol:scancode), only from a cited source.
# samsung32 (NEC bits with a 4.5 ms header) has no kernel encoder: ir_samsung builds it. Brands without a citable
# discrete code (eg Panasonic: Kaseikyo, no encoder; Philips, Hisense, TCL: none found) use learned codes.
ir_table() { # brand on|off
  local on off
  case $1 in
    # IRDB codes/LG/TV/4,-1.csv: POWER ON NEC 4 196, POWER OFF NEC 4 197 (github.com/probonopd/irdb)
    lg) on=nec:0x04c4 off=nec:0x04c5 ;;
    # Tasmota docs, Codes for IR Remotes, Samsung AA59 TV remote: ON 0xE0E09966, OFF 0xE0E019E6 (SAMSUNG, 32 bits;
    # tasmota.github.io/docs/Codes-for-IR-Remotes). The kernel decodes them as necx 0x070799 and 0x070798.
    samsung) on=samsung32:0xE0E09966 off=samsung32:0xE0E019E6 ;;
    # IRDB codes/Sony/TV/1,-1.csv: POWER ON Sony12 1 46, POWER OFF Sony12 1 47
    sony) on=sony12:0x1002e off=sony12:0x1002f ;;
    # IRDB codes/Toshiba/TV/64,-1.csv: POWER ON NEC 64 126, POWER OFF NEC 64 127
    toshiba) on=nec:0x407e off=nec:0x407f ;;
    *) return 1 ;;
  esac
  if [ "$2" = on ]; then echo "$on"; else echo "$off"; fi
}

# Samsung32 pulses and spaces in microseconds, bits MSB first as the code is written, timings of IRremoteESP8266's
# ir_Samsung.cpp (tick 560 us: header 8 ticks each, one 3 ticks of space, zero 1).
ir_samsung() {
  local i
  printf 'pulse 4480\nspace 4480\n'
  for i in {31..0}; do printf 'pulse 560\nspace %d\n' $(($1 >> i & 1 ? 1680 : 560)); done
  printf 'pulse 560\n'
}

# The first /dev/lirc* that can send (or receive) raw IR: gpio-ir-tx sends only, gpio-ir receives only.
ir_dev() {
  local d
  for d in /dev/lirc*; do
    [ -c "$d" ] && ir-ctl -d "$d" --features 2>/dev/null | grep -q "Device can $1 raw IR" && echo "$d" && return
  done
  return 1
}

# Send the power on or off code three times, 40 ms apart, as a remote held for a moment does. Discrete codes: a TV
# already in that state ignores it, so sending again is safe.
ir_send() {
  local dev code tmp='' args=() rc
  dev=$(ir_dev send) || { echo "No IR transmitter: wire one, set IR_TX_PIN and reboot" >&2; return 1; }
  if [ "$IR_CODES" = learned ]; then
    [ -s "$IR/$1" ] || { echo "No learned $1 code: sudo tvlink ir learn $1" >&2; return 1; }
    args=(-s "$IR/$1" -s "$IR/$1" -s "$IR/$1")
  else
    code=$(ir_table "$IR_CODES" "$1") || { echo "No IR codes for $IR_CODES" >&2; return 1; }
    if [[ $code == samsung32:* ]]; then
      tmp=$(mktemp) && ir_samsung "${code#*:}" >"$tmp" && args=(-s "$tmp" -s "$tmp" -s "$tmp")
    else
      args=(-S "$code" -S "$code" -S "$code")
    fi
  fi
  ir-ctl -d "$dev" -g 40000 "${args[@]}"
  rc=$?
  [ -z "$tmp" ] || rm -f "$tmp"
  [ "$rc" = 0 ] || { echo "IR: can't send on $dev" >&2; return 1; }
  echo "IR: power $1 sent ($IR_CODES)"
}

# Record the TV remote's power on or off button from the IR receiver (raw pulses, any protocol); send one code once.
ir() {
  local dev f=$IR/${2:-}
  [ "$(id -u)" = 0 ] || die "Run as root: sudo tvlink ir ${1:-learn} on|off"
  [[ ${2:-} =~ ^(on|off)$ ]] || die "Usage: sudo tvlink ir learn|test on|off"
  case ${1:-} in
    learn)
      dev=$(ir_dev receive) || die "No IR receiver: wire one, set IR_RX_PIN and reboot"
      install -d -m 700 "$IR" || die "Can't make $IR"
      echo "Point the TV remote at the receiver and press its power $2 button (30 s)"
      # One press, the first message only; pulses and spaces, ending on a pulse, as ir-ctl --send takes them.
      timeout 30 ir-ctl -d "$dev" -r -1 --mode2 | awk '/^(pulse|space) [0-9]+$/' | sed '${/^space/d}' >"$f.tmp"
      [ "$(grep -c . "$f.tmp")" -ge 16 ] && [ "$(head -c 5 "$f.tmp")" = pulse ] ||
        { rm -f "$f.tmp"; die "Nothing usable received: try again, closer to the receiver"; }
      mv -f "$f.tmp" "$f" || die "Can't write $f"
      echo "Learned power $2: $(grep -c . "$f") pulses and spaces in $f. Use them: sudo tvlink set IR_CODES=learned" ;;
    test) ir_send "$2" ;;
    *) die "Usage: sudo tvlink ir learn|test on|off" ;;
  esac
}

# Wi-Fi networks from the conf as NetworkManager profiles in RAM only (save no), rebuilt at boot and on tvlink set,
# so the conf stays the one place they live, also under the read-only overlay. Imager's own profile stays a fallback.
net() {
  local n ssid psk args seen
  [ "$(id -u)" = 0 ] || die "Run as root: sudo tvlink net"
  [ -z "$WIFI_COUNTRY" ] || iw reg set "$WIFI_COUNTRY" || echo "Can't set the Wi-Fi country to $WIFI_COUNTRY" >&2
  # A unit imaged for Ethernet has the radio off until a country is set: NetworkManager turns it on and keeps it on.
  [ -z "$WIFI1_SSID$WIFI2_SSID" ] || nmcli radio wifi on || echo "Can't turn Wi-Fi on" >&2
  for n in 1 2; do
    ssid=WIFI${n}_SSID psk=WIFI${n}_PSK seen=/run/tvlink-wifi$n
    # Unchanged since the last run this boot: leave it alone, so the link (and a remote session on it) stays up. Both
    # sides go through $(...), which drops the trailing newline an open network (blank PSK) leaves.
    [ "$(cat "$seen" 2>/dev/null)" != "$(printf %s "${!ssid:+${!ssid}$'\n'${!psk}}")" ] || continue
    nmcli connection delete "tvlink-wifi$n" >/dev/null 2>&1
    rm -f "$seen"
    [ -n "${!ssid}" ] || continue
    # hidden yes: also joins networks that do not broadcast their name
    args=(connection add save no type wifi con-name "tvlink-wifi$n" ifname wlan0 ssid "${!ssid}" wifi.hidden yes
      connection.autoconnect-priority $((30 - 10 * n)))
    [ -z "${!psk}" ] || args+=(wifi-sec.key-mgmt wpa-psk wifi-sec.psk "${!psk}")
    if nmcli "${args[@]}" >/dev/null; then
      (umask 077 && printf '%s\n%s' "${!ssid}" "${!psk}" >"$seen")
      echo "Wi-Fi $n: ${!ssid}"
    else
      echo "Wi-Fi $n: can't add ${!ssid}" >&2
    fi
  done
}

# The HDMI hotplug and EDID arguments of a kernel command line, sorted.
hdmi_args() { grep -oE '(vc4\.force_hotplug|drm\.edid_firmware)=[^ ]*' "$1" 2>/dev/null | sort | paste -sd' ' -; }

# Health on one screen, for remote support and the hardware checklist. Read-only; sudo adds the CEC and IR answers.
doctor() {
  local host=${BOARD_URL#*://} dev hp pend edids src files
  host=${host%%[/?#]*} host=${host##*@}
  echo "tvlink $VERSION on $(hostname), $(uptime -p 2>/dev/null), IP $(hostname -I 2>/dev/null)"
  if [ -z "$BOARD_URL" ]; then echo "Board: none (SOURCE=$SOURCE)"
  elif board_up; then echo "Board: $host answers HTTP $code"
  else echo "Board: $host gives ${code:-no answer}"
  fi
  { read -r src; read -r files; } < <(content)
  src=${src/usb/USB stick} && src=${src/card/SD card}
  echo "Local files: $(tr ',' '\n' <<<"$files" | grep -c .)${src:+ ($src)}"
  [ "$USB_CONTENT" = 0 ] || echo "USB stick: $(findmnt -no SOURCE "$USB" 2>/dev/null || echo none)"
  [ -z "$CONTENT_URL" ] || echo "Synced content: $(content_cmd status)"
  echo "Services: $(systemctl is-active tvlink tvlink-power tvlink-net 2>/dev/null | paste -sd' ' -)," \
    "next reboot $(systemctl show -p NextElapseUSecRealtime --value tvlink-reboot.timer 2>/dev/null)"
  echo "Clock synced: $(timedatectl show -p NTPSynchronized --value 2>/dev/null)," \
    "RTC $(date -d "@$(cat /sys/class/rtc/rtc0/since_epoch 2>/dev/null)" '+%F %T' 2>/dev/null)"
  echo "Power and heat: $(vcgencmd get_throttled 2>/dev/null) $(vcgencmd measure_temp 2>/dev/null)"
  echo "Memory: $(free -m 2>/dev/null | awk '/^Mem:/ {print $7 " MB free of " $2}')," \
    "swap $(free -m 2>/dev/null | awk '/^Swap:/ {print $3 " MB used"}')"
  echo "Disk free: boot $(df -h --output=avail /boot/firmware 2>/dev/null | tail -1)," \
    "root $(df -h --output=avail / 2>/dev/null | tail -1)"
  echo "HDMI: $(cat /sys/class/drm/card*-HDMI-A-*/status 2>/dev/null | paste -sd' ' -), TV $(status)"
  echo "TV power: $POWER_METHOD$([ "$POWER_METHOD" != ir ] || echo ", codes $IR_CODES," \
    "transmitter $(ir_dev send || echo none), receiver $(ir_dev receive || echo none)")"
  hp=off pend='' edids=$(cd "$EDID" 2>/dev/null && compgen -G 'tvlink-*.bin' | paste -sd' ' -)
  [ "$HDMI_FORCE_HOTPLUG" = 0 ] || hp=on
  [ "$(hdmi_args "$BOOT/cmdline.txt")" = "$(hdmi_args /proc/cmdline)" ] || pend=" (reboot to apply)"
  echo "HDMI at boot: force hotplug $hp, EDID ${edids:-from the TV}$pend"
  for dev in /dev/cec*; do
    [ -e "$dev" ] && echo "CEC $dev: address $(cec-ctl -d "$dev" 2>/dev/null | awk '/Physical Address/ {print $NF}')"
  done
  echo "Wi-Fi: $(nmcli -t -f NAME connection show --active 2>/dev/null | paste -sd' ' -)," \
    "$(iw dev wlan0 get power_save 2>/dev/null)"
  echo "Tunnel: $(tunnel_state)"
  echo "Watchdog: $(systemctl show -p RuntimeWatchdogUSec --value 2>/dev/null)," \
    "root $(grep -q ' / overlay ' /proc/mounts 2>/dev/null && echo read-only || echo writable)"
  echo "Versions: $(dpkg-query -W -f '${Package} ${Version}, ' cage chromium wlr-randr v4l-utils 2>/dev/null)"
}

# off, connected or not connected. No root needed: whether the token file exists, and cloudflared's ready check.
tunnel_state() {
  if [ ! -s "$TUNNEL" ]; then echo off
  elif curl -fs -m 3 -o /dev/null "$TUNNEL_READY"; then echo connected
  else echo "not connected"
  fi
}

# cloudflared from Cloudflare's own apt repo, signed by its key. Only when a token is first set: a unit without a
# tunnel never gets the repo or the package. Updates then come with the security updates (install.sh).
cloudflared_install() {
  local key=/usr/share/keyrings/cloudflare-main.gpg
  command -v cloudflared >/dev/null && return
  echo "Installing cloudflared from pkg.cloudflare.com"
  curl -fsSL -m 60 -o "$key.tmp" https://pkg.cloudflare.com/cloudflare-main.gpg && mv -f "$key.tmp" "$key" &&
    echo "deb [signed-by=$key] https://pkg.cloudflare.com/cloudflared any main" \
      >/etc/apt/sources.list.d/cloudflared.list &&
    apt-get -q -o DPkg::Lock::Timeout=120 update >/dev/null &&
    DEBIAN_FRONTEND=noninteractive apt-get -q -y -o DPkg::Lock::Timeout=120 install cloudflared >/dev/null
}

# Set the tunnel's token (written root only, beside then renamed) and (re)start the tunnel; blank: stop it for good.
tunnel_set() {
  if [ -z "$1" ]; then
    systemctl disable --now tvlink-tunnel 2>/dev/null
    rm -f "$TUNNEL"
    return
  fi
  cloudflared_install || die "Can't install cloudflared: token not saved"
  if ! install -d -m 755 "${TUNNEL%/*}" || ! (umask 077 && printf '%s\n' "$1" >"$TUNNEL.tmp") ||
    ! mv -f "$TUNNEL.tmp" "$TUNNEL"; then
    die "Can't write $TUNNEL"
  fi
  systemctl enable --quiet tvlink-tunnel || die "Can't enable tvlink-tunnel"
  systemctl restart tvlink-tunnel || die "Can't start tvlink-tunnel"
}

# A USB stick's file system (FAT or exFAT; tvlink-usb@.service, from the udev rule): mounted read-only, without
# devices, setuid or programs, where the kiosk can read it, and only if it has a tvlink folder; unmounted when pulled.
usb() {
  local dev=/dev/${2:-} disk fs
  [ "$(id -u)" = 0 ] || die "Run as root: sudo tvlink usb mount|unmount sdXN"
  [[ ${2:-} =~ ^sd[a-z]+[0-9]*$ ]] || die "Usage: tvlink usb mount|unmount sdXN"
  case ${1:-} in
    mount)
      [ "$USB_CONTENT" = 1 ] || { echo "$dev: USB_CONTENT=0, not used"; return 0; }
      disk=$(lsblk -dno PKNAME "$dev") && disk=/dev/${disk:-$2} fs=$(lsblk -dno FSTYPE "$dev")
      [[ $fs =~ ^(vfat|exfat)$ ]] || { echo "$dev: ${fs:-no} file system, not FAT or exFAT"; return 0; }
      # Never a disk the Pi runs from (booted from USB): nothing on it may be mounted yet.
      [ -z "$(lsblk -nro MOUNTPOINTS "$disk" | tr -d '\n')" ] || { echo "$dev: its disk is in use"; return 0; }
      ! mountpoint -q "$USB" || { echo "$dev: another stick is in use"; return 0; }
      install -d -m 755 "$USB" || die "Can't make $USB"
      mount -t "$fs" -o ro,nosuid,nodev,noexec,fmask=0133,dmask=0022 "$dev" "$USB" || die "$dev: can't mount it"
      if [ -d "$USB/tvlink" ]; then echo "$dev: playing its tvlink folder"
      else umount "$USB" && echo "$dev: no tvlink folder, not used"
      fi ;;
    unmount) [ "$(findmnt -no SOURCE "$USB")" != "$dev" ] || { umount -l "$USB" && echo "$dev: unmounted"; } ;;
    *) die "Usage: tvlink usb mount|unmount sdXN" ;;
  esac
}

# USB_CONTENT changed: let go of any stick, then (on) offer the sticks already in to tvlink-usb@ again.
usb_apply() {
  systemctl stop 'tvlink-usb@*.service'
  [ "$1" = 0 ] || udevadm trigger --action=add --subsystem-match=block --property-match=ID_BUS=usb
}

# Synced content: sync now (restarts tvlink-content, which syncs at start) and say how it went; the last result; or a
# manifest of a folder's files, to serve beside them.
content_cmd() {
  local out
  case ${1:-} in
    sync)
      [ "$(id -u)" = 0 ] || die "Run as root: sudo tvlink content sync"
      [ -n "$CONTENT_URL" ] || die "No CONTENT_URL: nothing to sync"
      systemctl restart tvlink-content || die "Can't start tvlink-content"
      for _ in {1..120}; do [ -s "$SYNC_STATE" ] && break; sleep 1; done
      [ -s "$SYNC_STATE" ] || die "Still syncing: tvlink content status, journalctl -u tvlink-content"
      out=$("${0%/*}/tvlink-content" status) && echo "$out" && [[ $out != Failed* ]] ;;
    status) if [ -z "$CONTENT_URL" ]; then echo off; else "${0%/*}/tvlink-content" status; fi ;;
    manifest) [ -d "${2:-}" ] || die "Usage: tvlink content manifest DIR"; "${0%/*}/tvlink-content" manifest "$2" ;;
    *) die "Usage: tvlink content sync|status|manifest DIR" ;;
  esac
}

# Hourly (tvlink-lastgood.timer): keep the kiosk's last live screenshot on the card, for the splash at a start with no
# network and no local content. Read as the kiosk, whose folder it is: root opens nothing the kiosk could have swapped
# for a link or a FIFO. Only a newer JPEG replaces the copy, beside then renamed, with the time it was taken.
lastgood() {
  local src=${STATUS%/*}/last.jpg t
  [ "$(id -u)" = 0 ] || die "Run as root: sudo tvlink lastgood"
  [ "$LAST_GOOD" = 1 ] || { rm -f "$LAST"; return 0; }
  t=$(runuser -u kiosk -- timeout 5 stat -c %Y -- "$src" 2>/dev/null) || return 0
  [ "$t" -gt "$(stat -c %Y "$LAST" 2>/dev/null || echo 0)" ] || return 0
  install -d -m 755 "${LAST%/*}" || die "Can't make ${LAST%/*}"
  if runuser -u kiosk -- timeout 10 setsid -w head -c 8M -- "$src" >"$LAST.tmp" 2>/dev/null &&
    [ "$(od -An -tx1 -N3 "$LAST.tmp" | tr -d ' \n')" = ffd8ff ] && chmod 644 "$LAST.tmp" &&
    touch -d "@$t" "$LAST.tmp" && mv -f "$LAST.tmp" "$LAST"; then
    echo "Last good screen kept, from $(date -d "@$t" '+%F %H:%M')"
  else
    rm -f "$LAST.tmp"
    echo "No usable screenshot from the kiosk" >&2
  fi
}

# A boot file, only when it changes: beside, flush, rename, flush, so a cut mid-write never leaves one the Pi can't
# boot from.
boot_write() { # file content
  [ "$2" != "$(cat "$1" 2>/dev/null)" ] || return 0
  if ! printf '%s\n' "$2" >"$1.tmp" || ! sync "$1.tmp" || ! mv -f "$1.tmp" "$1" || ! sync -f "$1"; then
    rm -f "$1.tmp"
    die "Can't write $1"
  fi
  echo "Reboot to apply: ${1##*/} changed"
}

# The boot files from the settings. cmdline.txt: HDMI mode, forced hotplug and captured EDIDs, no console blanking, no
# boot text or cursor (the TV goes from black to the splash; boot logs stay in journalctl). config.txt: the IR overlays,
# in tvlink's block at the end. Run by install.sh, tvlink set and tvlink edid; the original cmdline.txt is kept once.
IR_MARK='# tvlink: IR transmitter and receiver (POWER_METHOD=ir), rewritten by tvlink set'
boot() {
  local cmd ours f c edid='' cfg
  [ "$(id -u)" = 0 ] || die "Run as root: sudo tvlink boot"
  [ -e "$BOOT/cmdline.txt.orig" ] || cp "$BOOT/cmdline.txt" "$BOOT/cmdline.txt.orig" || die "Can't copy cmdline.txt"
  ours='^(video=HDMI-A-[0-9]+:.*|consoleblank=.*|quiet|loglevel=.*|logo\.nologo|vt\.global_cursor_default=.*|'
  ours+='vc4\.force_hotplug=.*|drm\.edid_firmware=.*)$'
  cmd=$(tr ' ' '\n' <"$BOOT/cmdline.txt" | grep -vE "$ours" | paste -sd' ' -)
  cmd+=" consoleblank=0 quiet loglevel=3 logo.nologo vt.global_cursor_default=0"
  [ "$RESOLUTION" = auto ] || cmd+=" video=HDMI-A-1:$RESOLUTION video=HDMI-A-2:$RESOLUTION"
  # A bit per port, bit 0 for HDMI0 (vc4_hdmi.c, force_hotplug): HDMI0 only, so a free HDMI1 never shows as a screen.
  [ "$HDMI_FORCE_HOTPLUG" = 0 ] || cmd+=" vc4.force_hotplug=1"
  for f in "$EDID"/tvlink-*.bin; do
    [ -f "$f" ] || continue
    c=${f##*/tvlink-} && edid+="${edid:+,}${c%.bin}:edid/${f##*/}"
  done
  [ -z "$edid" ] || cmd+=" drm.edid_firmware=$edid" # connector:file, from /lib/firmware (kernel-parameters.txt)
  boot_write "$BOOT/cmdline.txt" "$cmd"
  # Our block and any other gpio-ir overlay lines go (with blank lines before the block), then ours go back at the end.
  cfg=$(awk -v m="$IR_MARK" '/^[[:space:]]*$/ {b = b $0 "\n"; next}
    $0 == m {b = ""; if ((getline) > 0 && $0 != "[all]") print; next}
    /^dtoverlay=gpio-ir(-tx)?(,|$)/ {next} {printf "%s", b; b = ""; print}' "$BOOT/config.txt")
  if [ "$POWER_METHOD" = ir ]; then
    cfg+=$'\n\n'"$IR_MARK"$'\n[all]\n'"dtoverlay=gpio-ir-tx,gpio_pin=$IR_TX_PIN"
    # rc-empty: the receiver turns no button into a key press in the kiosk
    [ -z "$IR_RX_PIN" ] || cfg+=$'\n'"dtoverlay=gpio-ir,gpio_pin=$IR_RX_PIN,rc-map-name=rc-empty"
  fi
  boot_write "$BOOT/config.txt" "$cfg"
}

# A whole EDID: 128-byte blocks, the fixed header, and each block summing to 0.
edid_ok() {
  local n
  n=$(stat -c %s "$1" 2>/dev/null) && [ "$n" -ge 128 ] && [ $((n % 128)) = 0 ] &&
    [ "$(od -An -tx1 -N8 "$1" | tr -d ' \n')" = 00ffffffffffff00 ] &&
    od -An -tu1 -v "$1" | awk '{for (i = 1; i <= NF; i++) {s += $i; if (++n % 128 == 0 && s % 256) bad = 1}}
      END {exit bad}'
}

# Keep the connected TV's EDID, so the Pi sees the same modes when the TV is off or unplugged at boot (best with
# HDMI_FORCE_HOTPLUG=1); or forget it. The files also go into the initramfs, for a display driver loaded from it.
edid() {
  local d c n=0
  [ "$(id -u)" = 0 ] || die "Run as root: sudo tvlink edid capture|clear"
  case ${1:-} in
    capture)
      install -d -m 755 "$EDID" || die "Can't make $EDID"
      for d in $DRM; do
        [ "$(cat "$d/status" 2>/dev/null)" = connected ] || continue
        c=${d##*/} && c=${c#card*-}
        cat "$d/edid" >"$EDID/tvlink-$c.bin.tmp" 2>/dev/null
        if edid_ok "$EDID/tvlink-$c.bin.tmp" && mv -f "$EDID/tvlink-$c.bin.tmp" "$EDID/tvlink-$c.bin"; then
          echo "$c: EDID saved to $EDID/tvlink-$c.bin" && n=$((n + 1))
        else
          rm -f "$EDID/tvlink-$c.bin.tmp"
          echo "$c: no valid EDID (is the TV on?)" >&2
        fi
      done
      [ "$n" -gt 0 ] || die "No EDID captured: connect the TV, turn it on, and try again" ;;
    clear) rm -f "$EDID"/tvlink-*.bin && echo "EDID cleared: the Pi reads the TV's own" ;;
    *) die "Usage: sudo tvlink edid capture|clear" ;;
  esac
  boot
  if command -v update-initramfs >/dev/null; then
    update-initramfs -u -k all >/dev/null 2>&1 || echo "Can't update the initramfs: update-initramfs -u -k all" >&2
  fi
}

# Hand a request (identify, screenshot, reload, display on|off) to tvlink-agent, which picks it up within a second.
# Written as kiosk, who owns /run/tvlink: root never writes through a path the browser's user could have swapped
# for a link.
ask() {
  local req=${STATUS%/*}/request
  [ -d "${STATUS%/*}" ] || die "The kiosk is not running"
  [ "$(id -u)" = 0 ] || die "Run as root: sudo tvlink $1"
  for _ in {1..5}; do [ -e "$req" ] || break; sleep 1; done # let an earlier request be taken first
  # setsid: no controlling terminal, so the kiosk can't type into root's; timeout: a planted FIFO can't hold us.
  # shellcheck disable=SC2016 # $1 and $2 belong to the inner sh
  runuser -u kiosk -- timeout 5 setsid -w sh -c 'echo "$1" >"$2.tmp" && mv -fT "$2.tmp" "$2"' _ "$1" "$req" ||
    die "Can't pass the request to the kiosk"
}

# What the TV shows now, as a JPEG in RAM. Waits up to 30 s for the agent; only a plain file counts, and it is never
# opened here (the folder belongs to the kiosk user).
screenshot() {
  local shot=${STATUS%/*}/screen.jpg
  rm -f "$shot" 2>/dev/null
  ask screenshot
  for _ in {1..30}; do
    if [ -f "$shot" ] && [ ! -L "$shot" ] && [ -s "$shot" ]; then
      echo "Saved $shot ($(du -k "$shot" | cut -f1) KB)"
      return
    fi
    sleep 1
  done
  die "No screenshot after 30 s: see journalctl -t tvlink"
}

# Update from a release tarball: download, check its sha256, unpack, then run its install.sh as a transient unit,
# so a dropped remote shell can't stop it halfway. Follow it with journalctl -u tvlink-update.
update() {
  local url=${1:-} sum=${2:-} dir inst
  [ "$(id -u)" = 0 ] || die "Run as root: sudo tvlink update URL SHA256"
  [[ $url =~ ^https:// && $sum =~ ^[0-9a-f]{64}$ ]] || die "Usage: sudo tvlink update https://.../tvlink.tar.gz SHA256"
  dir=$(mktemp -d /var/tmp/tvlink-update.XXXXXX) || die "Can't make a working folder"
  # shellcheck disable=SC2064 # expand now: dir is local and may be gone when the trap runs
  trap "rm -rf '$dir'" EXIT # gone on any failure; the install unit removes it after a good run
  curl -fsSL -m 300 -o "$dir/release.tar.gz" "$url" || die "Download failed: $url"
  echo "$sum  $dir/release.tar.gz" | sha256sum -c --quiet || die "Checksum does not match: nothing installed"
  tar -xzf "$dir/release.tar.gz" -C "$dir" || die "Can't unpack the release"
  inst=$(find "$dir" -maxdepth 2 -name install.sh | head -n 1)
  [ -n "$inst" ] || die "No install.sh in the release"
  systemd-run --unit tvlink-update --collect -p ExecStopPost="/bin/rm -rf $dir" "$inst" >/dev/null ||
    die "Can't start the install (another update still running?)"
  trap - EXIT
  echo "Installing from $dir: journalctl -u tvlink-update -f"
}

# Recent log lines of a part, for the console.
logs() {
  local args
  case ${1:-} in
    kiosk) args=(-t tvlink) ;; # the kiosk's lines come from its login session
    power | net) args=(-u "tvlink-$1") ;;
    *) die "Usage: tvlink logs kiosk|power|net" ;;
  esac
  journalctl -q --no-pager -n 200 -o short-iso "${args[@]}"
}

# The unit console's claim code, shown on the splash until a password is set; reset goes back to claim mode.
console() {
  local f=/run/tvlink-console/claim pw=/var/lib/tvlink-console/password code=''
  [ "$(id -u)" = 0 ] || die "Run as root: sudo tvlink console ${1:-claim}"
  case ${1:-} in
    claim) ;;
    reset) rm -f "$pw" && { systemctl restart tvlink-console || die "Can't restart tvlink-console"; } ;;
    *) die "Usage: sudo tvlink console claim|reset" ;;
  esac
  [ ! -e "$pw" ] || die "Already claimed. Forgotten the password: sudo tvlink console reset"
  for _ in {1..10}; do # not through a link: the folder is the console user's
    [ -f "$f" ] && [ ! -L "$f" ] && code=$(head -c 16 "$f") && [ -n "$code" ] && break
    sleep 1
  done
  [ -n "$code" ] || die "No claim code: is the console running? systemctl status tvlink-console"
  echo "Console: http://$(hostname).local  Code: ${code//[^A-Z0-9-]/}"
}

# BOARD_URL alone, with the kiosk running: no restart and no splash. The agent loads the new page in a background tab
# and swaps it in once it has loaded; if it fails to load, the old page stays. Waits up to 45 s to say which.
board_switch() {
  local since line=''
  [ "$SOURCE" != folder ] || return 0 # local content only: the link waits
  board_up 2>/dev/null ||
    { echo "The new page gives ${code:-no answer}: the old one stays until it answers"; return 0; }
  since=$(date '+%F %T.%6N')
  for _ in {1..45}; do
    line=$(journalctl -q -t tvlink --since "$since" -o cat 2>/dev/null | grep -m1 -E '^(Page switch|Splash: ready)')
    [ -z "$line" ] || break
    sleep 1
  done
  case $line in
    'Splash: ready'*) echo "The new page is showing" ;;
    '') echo "Still loading the new page: journalctl -t tvlink" ;;
    *) echo "$line" ;;
  esac
}

# Change settings in the conf (eg over a remote shell), then restart what uses them.
set_conf() {
  [ "$(id -u)" = 0 ] || die "Run as root: sudo tvlink set KEY=value"
  [ $# -gt 0 ] || die "Usage: tvlink set KEY=value... (keys: $KEYS)"
  local kv key value kiosk=0 net=0 power=0 boot=0 tunnel=- tx=$IR_TX_PIN rx=$IR_RX_PIN switch=0 usb=- sync=0
  for kv in "$@"; do # check every value before writing any
    key=${kv%%=*} value=${kv#*=}
    [[ $kv == *=* && $key =~ ^[A-Z0-9_]+$ && " $KEYS " == *" $key "* ]] || die "Unknown setting: $kv (keys: $KEYS)"
    case $value in *"'"* | *$'\n'*) die "Value for $key can't contain ' or a newline" ;; esac
    case $key in
      BOARD_URL) [[ -z $value || $value =~ ^https?://[^[:space:]]+$ ]] ||
        die "BOARD_URL is an http(s) link, eg https://example.com/d/KEY" ;;
      POWER_MODE) [[ $value =~ ^(always|schedule|motion|manual|manual\+motion)$ ]] ||
        die "POWER_MODE is always, schedule, motion, manual or manual+motion" ;;
      TV_ON | TV_OFF) [[ -z $value || $value =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || die "$key is HH:MM, eg 06:00" ;;
      IDLE_MIN | MOTION_PIN) [[ $value =~ ^[0-9]+$ ]] || die "$key is a whole number" ;;
      POWER_METHOD) [[ $value =~ ^(cec|ir|signal|none)$ ]] || die "POWER_METHOD is cec, ir, signal or none" ;;
      IR_CODES) [[ -n $value && " $IR_BRANDS learned " == *" $value "* ]] ||
        die "IR_CODES is a brand with built-in codes ($IR_BRANDS) or learned" ;;
      IR_TX_PIN | IR_RX_PIN) [[ $value =~ ^([2-9]|1[0-9]|2[0-7])$ || ($key == IR_RX_PIN && -z $value) ]] ||
        die "$key is a GPIO from 2 to 27 (BCM number); IR_RX_PIN may be blank: no receiver"
        if [ "$key" = IR_TX_PIN ]; then tx=$value; else rx=$value; fi ;;
      HDMI_FORCE_HOTPLUG | USB_CONTENT | LAST_GOOD) [[ $value =~ ^[01]$ ]] || die "$key is 0 or 1" ;;
      CONTENT_URL) [[ -z $value || $value =~ ^https://[^[:space:]]+$ ]] ||
        die "CONTENT_URL is an https link to a manifest, eg https://example.com/tvlink/manifest.json" ;;
      CONTENT_SYNC_MIN) [[ $value =~ ^[1-9][0-9]{0,3}$ ]] || die "CONTENT_SYNC_MIN is 1 to 9999 minutes" ;;
      BROWSER_RESTART) [[ -z $value || $value =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] ||
        die "BROWSER_RESTART is HH:MM, eg 04:00, or blank for never" ;;
      SOURCE) [[ $value =~ ^(auto|folder)$ ]] || die "SOURCE is auto or folder" ;;
      SLIDE_SECONDS) [[ $value =~ ^[1-9][0-9]{0,4}$ ]] || die "SLIDE_SECONDS is 1 to 99999 seconds" ;;
      FIT) [[ $value =~ ^(contain|cover)$ ]] || die "FIT is contain or cover" ;;
      OVERLAY_CORNER) [[ $value =~ ^((top|bottom)-(left|right)|off)$ ]] ||
        die "OVERLAY_CORNER is bottom-right, bottom-left, top-right, top-left or off" ;;
      RESOLUTION) [[ $value =~ ^([0-9]+x[0-9]+(@[0-9]+)?|auto)$ ]] ||
        die "RESOLUTION is WIDTHxHEIGHT@RATE, eg 1920x1080@60, or auto" ;;
      WIFI_COUNTRY) [[ $value =~ ^([A-Z]{2})?$ ]] || die "WIFI_COUNTRY is a two-letter code, eg AU" ;;
      WIFI?_SSID) (LC_ALL=C && [ ${#value} -le 32 ]) || die "$key is at most 32 bytes" ;;
      WIFI?_PSK) [[ -z $value || ${#value} -ge 8 && ${#value} -le 63 ]] ||
        die "$key is 8 to 63 characters, or blank for an open network" ;;
      # base64 of JSON with the account (a), tunnel (t) and secret (s)
      TUNNEL_TOKEN) [[ -z $value || ($value =~ ^[A-Za-z0-9+/=_-]{40,4096}$ &&
        $(base64 -d <<<"$value" 2>/dev/null) == *'"t":'*) ]] ||
        die "TUNNEL_TOKEN is the tunnel's token from Cloudflare (eyJ...), or blank to turn the tunnel off" ;;
    esac
  done
  [ "$tx" != "$rx" ] || die "IR_TX_PIN and IR_RX_PIN can't be the same GPIO"
  touch "$CONF" || die "Can't write $CONF"
  for kv in "$@"; do
    key=${kv%%=*} value=${kv#*=}
    if [ "$key" = TUNNEL_TOKEN ]; then tunnel=$value && continue; fi # not in the conf: below
    # Write beside it, flush, rename, flush: a power cut leaves the old or the new conf (FAT has no journal, so
    # in practice, not in theory). Values pass through ENVIRON, so backslashes stay literal.
    # Keys match as read_conf reads them (spaces ignored), and every line for the key becomes one.
    if ! k=$key v="$key='$value'" awk '{l = $0; sub(/=.*/, "", l); gsub(/[[:space:]]/, "", l)}
      /=/ && l == ENVIRON["k"] {if (!f++) print ENVIRON["v"]; next} {print} END {if (!f) print ENVIRON["v"]}' \
      "$CONF" >"$CONF.tmp" || ! sync "$CONF.tmp" || ! mv -f "$CONF.tmp" "$CONF" || ! sync -f "$CONF"; then
      rm -f "$CONF.tmp"
      die "Can't write $CONF"
    fi
    if [[ $key == *_PSK && -n $value ]]; then echo "$key=(set)"; else echo "$key=$value"; fi
    case $key in
      # A new link alone, with the kiosk up: swapped in without a restart (board_switch)
      BOARD_URL) [ "$value" != "$BOARD_URL" ] || continue # unchanged: nothing to do
        BOARD_URL=$value
        if [ -n "$value" ] && systemctl -q is-active tvlink; then switch=1; else kiosk=1; fi ;;
      SOURCE | SLIDE_SECONDS | FIT | OVERLAY_CORNER | BROWSER_RESTART) kiosk=1 ;;
      LAST_GOOD) kiosk=1 && { [ "$value" = 1 ] || rm -f "$LAST"; } ;;
      USB_CONTENT) usb=$value ;; # the status loop rereads the settings: no restart
      CONTENT_URL | CONTENT_SYNC_MIN) sync=1 ;;
      RESOLUTION) kiosk=1 boot=1 ;;
      HDMI_FORCE_HOTPLUG | IR_TX_PIN | IR_RX_PIN) boot=1 ;;
      POWER_METHOD) power=1 boot=1 && rm -f "$SIGNAL" ;; # a new method starts with the signal on
      WIFI*) net=1 ;;
      *) power=1 ;;
    esac
  done
  [ "$boot" = 0 ] || "$0" boot || die "Can't update the boot files"
  [ "$power" = 0 ] || systemctl restart tvlink-power
  [ "$kiosk" = 0 ] || systemctl restart tvlink
  [ "$kiosk" = 1 ] || [ "$switch" = 0 ] || board_switch
  [ "$usb" = - ] || usb_apply "$usb"
  [ "$sync" = 0 ] || systemctl restart tvlink-content # it syncs at start, or with no CONTENT_URL removes what it had
  [ "$net" = 0 ] || systemctl restart tvlink-net
  [ "$tunnel" = - ] || { tunnel_set "$tunnel" && echo "TUNNEL_TOKEN=${tunnel:+(set)}"; }
}

case $1 in
  check) # Nightly reboot gate: never in the first hour after boot (eg a timer fired by a clock jump). While a
    # configured board is unreachable, skip for up to a week, so an outage keeps the last good board on screen.
    read -r up _ <"${TVLINK_UPTIME:-/proc/uptime}"
    ((${up%.*} > 3600)) || exit 1
    [ "$(systemctl is-active apt-daily-upgrade.service 2>/dev/null)" != activating ] || exit 1 # upgrade running
    [ "$SOURCE" = folder ] || [ -z "$BOARD_URL" ] || ((${up%.*} > 604800)) || board_up ;;
  kiosk) kiosk ;;
  browser) browser ;;
  on | off) tv "$1" ;;
  status) status ;;
  show) show ;;
  net) net ;;
  doctor) doctor ;;
  mode) set_mode quiet ;;
  identify) ask identify && echo "Name and IP on screen for up to 60 s" ;;
  reload) ask reload && echo "Reloading the page" ;;
  screenshot) screenshot ;;
  update) shift; update "$@" ;;
  set) shift; set_conf "$@" ;;
  keys) keys "${2:-}" ;;
  logs) logs "${2:-}" ;;
  console) console "${2:-}" ;;
  tunnel) tunnel_state ;;
  ir) shift; ir "$@" ;;
  usb) usb "${2:-}" "${3:-}" ;;
  content) content_cmd "${2:-}" "${3:-}" ;;
  lastgood) lastgood ;;
  edid) edid "${2:-}" ;;
  boot) boot ;;
  reboot) # planned, so POWER_MODE=manual does not wake the TV after it; in 3 s, so the console can answer first
    [ "$(id -u)" = 0 ] || die "Run as root: sudo tvlink reboot"
    touch /boot/firmware/.tvlink-planned-reboot
    systemd-run --quiet --collect --on-active=3 /bin/systemctl reboot && echo "Rebooting in 3 s" ;;
  *) die "Usage: tvlink show|doctor|on|off|status|identify|screenshot|reload|reboot|update URL SHA256|\
set KEY=value...|console claim|reset|ir learn|test on|off|edid capture|clear|content sync|status|manifest DIR" ;;
esac
