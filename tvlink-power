"""TV power: always on, on-hours, plus motion wake, manual, or manual plus motion wake, by any POWER_METHOD.
Usage: tvlink-power [test] | tvlink-power override [on|off [DURATION|until HH:MM]|clear] (as tvlink override)

POWER_MODE in tvlink.conf:
  always    on 24/7
  schedule  on from TV_ON to TV_OFF; standby at TV_OFF
  motion    as schedule, and outside those hours a sensor on MOTION_PIN wakes it; standby after IDLE_MIN without motion
  manual    people use the TV remote; the Pi only wakes the TV after a power cut (a boot that was not the planned
            nightly reboot)
  manual+motion  as manual, and the sensor wakes the TV when someone arrives after IDLE_MIN with nobody seen; the
            Pi never sends standby, so a TV switched off while people are still in the room stays off (with a PIR,
            people sitting still for IDLE_MIN count as gone: use an mmWave sensor where people sit)
On-time starts with `tvlink on` (wakes a TV that is not on, claims its input). Every 5 min after that the TV is woken
again if it reports standby, or if it answered before and has gone silent (some TVs drop hotplug in standby), so in
on-time any standby is undone, even one from the remote. A TV that never answers is only woken when on-time starts.
Standby is sent when on-time ends and at any start in off-hours; after a power cut it is re-sent for 10 min while the
TV may still be coming on. Until the clock can be trusted (NTP synced, or the RTC holds a sane date) the TV stays on.

POWER_METHOD: how `tvlink on|off` reaches the TV. cec answers status queries. ir never does (status unknown), so it is
handled as a TV that never answers: codes at the boundaries and after a power cut, never a re-wake loop. signal
reports what was last sent (on or off; off counts as standby). none: this exits.

An override (tvlink override) forces the TV on or off over any mode until an instant it stores, so a restart, a
reboot or a clock change keeps it; it is honoured once the clock can be trusted. While it lasts the TV is handled as in
on-time (on) or off-hours (off); when it ends the mode takes over again, and manual modes send nothing.
"""
import glob
import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime, time as dtime, timedelta

CLI = os.environ.get("TVLINK_CLI", "/usr/local/bin/tvlink")
MODES = ("always", "schedule", "motion", "manual", "manual+motion")
POLL = 300  # seconds between power checks during on-time
# tmpfs: present means this boot already ran, eg a restart after `tvlink set`
STARTED = os.environ.get("TVLINK_STARTED", "/run/tvlink-power")
PLANNED = os.environ.get("TVLINK_PLANNED", "/boot/firmware/.tvlink-planned-reboot")  # left by the nightly reboot
SYNCED = "/run/systemd/timesync/synchronized"  # timesyncd creates it once NTP has synced this boot
RTC = "/sys/class/rtc/rtc0/since_epoch"  # Pi 5 RTC: kept across a warm reboot, across a power cut only with a battery
CLOCK_FLOOR = 1793491200  # 2026-11-01: an RTC reading before this has lost power
OVERRIDE = os.environ.get("TVLINK_OVERRIDE", "/var/lib/tvlink/override")  # root only: {"power": "on", "until": epoch}
MAX_OVERRIDE = 31 * 86400


def read_conf(cli=CLI, **run):
    """Settings as tvlink reads them (tvlink show), so the conf has one parser. Empty means unset."""
    out = subprocess.run([cli, "show"], capture_output=True, text=True, errors="replace", timeout=60, **run).stdout
    return {k: v for k, v in (line.split("=", 1) for line in out.splitlines() if "=" in line) if v}


def hhmm(value):
    try:
        h, m = value.split(":")
        return dtime(int(h), int(m))
    except ValueError:
        return None


def in_hours(now, on, off):
    """From on to off, local time; off earlier than on wraps past midnight. now: naive local, with fold as
    datetime.now() sets it. Compared as instants, not wall time: the latest TV_ON or TV_OFF passed (its first pass when
    clocks go back, so one in the repeated hour acts once; one in a skipped hour acts an hour late)."""
    ts = now.timestamp()
    return max((b, is_on) for day in (now.date(), now.date() - timedelta(1)) for t, is_on in ((on, True), (off, False))
               if (b := datetime.combine(day, t).timestamp()) <= ts)[1]


def want_on(mode, now, on, off, motion_age, idle_s):
    """motion_age: seconds since the sensor last saw someone, or None."""
    if mode == "always" or in_hours(now, on, off):
        return True
    return mode == "motion" and motion_age is not None and motion_age < idle_s


def wanted(mode, now, on, off, motion_age, idle_s, override=None, trusted=True):
    """True (on), False (standby), or None: manual modes have no say. An override wins once the clock can be trusted;
    until then the TV stays on in the other modes."""
    if trusted and override:
        return override == "on"
    if mode.startswith("manual"):
        return None
    return not trusted or want_on(mode, now, on, off, motion_age, idle_s)


def presence(last, now, seen, idle_s):
    """manual+motion, one tick: (wake?, new last-seen time). Someone seen after idle_s with nobody is an arrival;
    while they stay, last keeps moving, so a held-high sensor never wakes the TV again."""
    return seen and now - last >= idle_s, now if seen else last


def step(want, prev, due, settling=False):
    """This tick's action: on when on-time starts, check (wake from standby) when a poll is due, off when it ends,
    settle (standby again unless reported) while a power cut in off-hours may still bring the TV on."""
    if want and want != prev:
        return "on"
    if want and due:
        return "check"
    if not want and prev:
        return "off"
    if not want and settling and due:
        return "settle"
    return None


def settings(conf):
    """(mode, on, off, idle seconds, pin); falls back to always when the mode or hours are unusable."""
    mode = conf.get("POWER_MODE", "schedule").lower()
    on, off = hhmm(conf.get("TV_ON", "")), hhmm(conf.get("TV_OFF", ""))
    if mode not in MODES:
        print(f"Unknown POWER_MODE={mode}, using always", flush=True)
        mode = "always"
    if mode in ("schedule", "motion") and not (on and off and on != off):
        print(f"POWER_MODE={mode} needs different TV_ON and TV_OFF, using always", flush=True)
        mode = "always"
    idle = conf.get("IDLE_MIN", "15")
    pin = conf.get("MOTION_PIN", "17")
    idle_min = max(1, int(idle)) if idle.isdigit() else 15  # 0 would never wake: motion is 0 s old on its own tick
    return mode, on, off, idle_min * 60, int(pin) if pin.isdigit() else 17


def clock_ok():
    """True when the wall clock can be trusted for on-hours."""
    if os.path.exists(SYNCED):
        return True
    try:
        with open(RTC) as f:
            return int(f.read()) > CLOCK_FLOOR
    except (OSError, ValueError):
        return False


def after_power_cut():
    """True on the first run after a boot that was not the planned nightly reboot, eg a power cut."""
    if os.path.exists(STARTED):
        return False
    open(STARTED, "w").close()
    planned = os.path.exists(PLANNED)
    if planned:
        os.remove(PLANNED)
    return not planned


def follow_up(action, seen, answered):
    """After a check or settle, what to send given what the TV reports: on, standby (or off: signal), unknown."""
    asleep = seen in ("standby", "off")
    if action == "settle":
        return None if asleep else "off"
    if action == "check" and (asleep or (seen == "unknown" and answered)):
        return "on"  # standby, or silent after answering before: it dropped hotplug in standby
    return None


def next_at(now, times):
    """The first instant after now (naive local) at one of the times of day: today or tomorrow, as on-hours count."""
    ts = now.timestamp()
    return min(b for day in (now.date(), now.date() + timedelta(1)) for t in times
               if (b := datetime.combine(day, t).timestamp()) > ts)


def until(args, now, mode, on, off):
    """When an override set now ends: [] the next TV_ON or TV_OFF (schedule and motion only), ["4h"] (d, h, m, eg
    1h30m), or ["until", "07:00"] its next time. ValueError says what to give instead."""
    if not args:
        if mode not in ("schedule", "motion"):
            raise ValueError(f"POWER_MODE={mode} has no on-hours to end it: give a time, eg 4h or until 07:00")
        return next_at(now, (on, off))
    if len(args) == 2 and args[0] == "until" and (t := hhmm(args[1])):
        return next_at(now, (t,))
    m = re.fullmatch(r"(?:(\d{1,3})d)?(?:(\d{1,4})h)?(?:(\d{1,5})m)?", args[0]) if len(args) == 1 else None
    secs = sum(int(n or 0) * k for n, k in zip(m.groups(), (86400, 3600, 60))) if m else 0
    if not 60 <= secs <= MAX_OVERRIDE:
        raise ValueError("Give how long, eg 30m, 4h, 1h30m or 2d (31d at most), or until HH:MM")
    return now.timestamp() + secs


def read_override(path=None, now=None):
    """(power, until) of the override in force, or None: none set, unreadable, or ended."""
    try:
        with open(path or OVERRIDE) as f:
            o = json.load(f)
        power, end = o["power"], float(o["until"])
    except (OSError, ValueError, KeyError, TypeError):
        return None
    return (power, end) if power in ("on", "off") and end > (time.time() if now is None else now) else None


def when(ts):
    return time.strftime("%a %d %b %H:%M", time.localtime(ts))  # eg Tue 10 Nov 07:00


def override(args, path=None):
    """tvlink override: show, set (on|off [DURATION|until HH:MM]) or clear. Written root only, beside then renamed."""
    path = path or OVERRIDE
    if not args:
        o = read_override(path)
        return f"{o[0]} until {when(o[1])}" if o else "none"
    if args == ["clear"]:
        try:
            os.remove(path)
        except FileNotFoundError:
            pass
        return "Override cleared: back to the power mode"
    if args[0] not in ("on", "off"):
        raise ValueError("Usage: sudo tvlink override [on|off [DURATION|until HH:MM]|clear]")
    conf = read_conf(CLI)
    if conf.get("POWER_METHOD", "cec") == "none":
        raise ValueError("POWER_METHOD=none: the Pi never turns the TV on or off")
    mode, on, off, _, _ = settings(conf)
    end = until(args[1:], datetime.now(), mode, on, off)
    fd = os.open(f"{path}.tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump({"power": args[0], "until": int(end)}, f)
        f.flush()
        os.fsync(f.fileno())
    os.replace(f"{path}.tmp", path)
    return f"Override: TV {args[0]} until {when(end)}"


def tv(action):
    """tvlink on|off|status. Returns its output (status: on, standby or unknown); on and off output also goes to the
    journal. A hung cec-ctl raises after 60 s and systemd restarts the service."""
    out = subprocess.run([CLI, action], stdout=subprocess.PIPE, text=True, timeout=60).stdout.strip()
    if action != "status" and out:
        print(out, flush=True)
    return out


def main():
    conf = read_conf()
    method = conf.get("POWER_METHOD", "cec")
    if method == "none":
        print("POWER_METHOD=none: not controlling the TV", flush=True)
        return
    mode, on, off, idle, pin = settings(conf)
    power_cut = after_power_cut()
    pir = None
    if mode in ("motion", "manual+motion"):
        try:
            from gpiozero import MotionSensor
            pir = MotionSensor(pin)
        except Exception as e:  # no sensor, no gpiozero, wrong pin: still keep on-hours (or manual)
            print(f"Motion sensor on GPIO{pin} unavailable ({e}): no motion wake", flush=True)
    for _ in range(30 if method == "cec" else 0):  # /dev/cec* can appear after boot starts this
        if glob.glob("/dev/cec*"):
            break
        time.sleep(1)
    trusted = clock_ok()
    if mode.startswith("manual"):
        forced = trusted and read_override()  # an override in force decides, not the power cut
        print(f"POWER_MODE={mode} by {method}: "
              + ("power cut, waking the TV" if power_cut and not forced else "leaving the TV alone"),
              flush=True)
        woke = False
        for _ in range(20 if power_cut and not forced else 0):  # the TV may still be starting up after the same cut
            seen = tv("status")
            if seen == "on" or (woke and seen != "standby"):  # stop once a wake got through: no input grabbing
                break
            woke = "woken" in tv("on")
            time.sleep(30)
        if pir is not None:
            print(f"Motion wake after {idle // 60} min with nobody seen", flush=True)
    else:
        print(f"POWER_MODE={mode} by {method}" + ("" if mode == "always" else f" {on:%H:%M}-{off:%H:%M}")
              + (f", idle {idle // 60} min" if mode == "motion" else ""), flush=True)
        if not trusted:
            print("Clock not set yet (no NTP sync, no RTC time): keeping the TV on until it is", flush=True)
    settle_until = time.monotonic() + 600 if power_cut else 0.0  # a TV set to come back on after a cut may be slow
    prev, next_check, motion_at, state, answered, held = None, 0.0, None, None, False, None
    last = time.monotonic()  # manual+motion: anyone here at a start (power cut, reboot, tvlink set) is already here
    while True:
        if not trusted and clock_ok():
            trusted = True
            print("Clock set", flush=True)
        now = time.monotonic()
        moving = pir is not None and pir.motion_detected  # held high while someone stays, eg PIR or mmWave
        if moving:
            motion_at = now
        o = read_override() if trusted else None
        if (o and o[0]) != held:
            print(f"Override: TV {o[0]} until {when(o[1])}" if o else f"Override over: back to POWER_MODE={mode}",
                  flush=True)
            held = o and o[0]
        age = None if motion_at is None else now - motion_at
        want = wanted(mode, datetime.now(), on, off, age, idle, held, trusted)
        if mode == "manual+motion":  # wake on an arrival, never send standby
            wake, last = presence(last, now, moving, idle)
            if wake and want is None:
                print("Motion after a quiet spell: waking the TV", flush=True)
                tv("on")
        if want is None:  # manual, no override: the TV is left alone
            prev = None
            time.sleep(1)
            continue
        if prev is None:  # first tick: wake in on-hours, one standby in off-hours (a restart must not leave it on)
            prev = not want
        action = step(want, prev, now >= next_check, now < settle_until)
        if action in ("check", "settle"):
            seen = tv("status")
            answered = answered or seen == "on"
            if seen != state:
                state = seen
                print(f"TV reports {state}", flush=True)
            if send := follow_up(action, seen, answered):
                tv(send)
        elif action:
            tv(action)
        if action in ("on", "check"):
            next_check = now + POLL
        elif action in ("off", "settle"):
            next_check = now + 30
        prev = want
        time.sleep(1)


def test():
    import tempfile
    global STARTED, PLANNED, SYNCED, RTC, CLI
    d = lambda h, m=0: datetime(2026, 1, 1, h, m)
    six, ten, two = dtime(6), dtime(22), dtime(2)
    assert in_hours(d(6), six, ten) and in_hours(d(21, 59), six, ten) and not in_hours(d(22), six, ten)
    assert in_hours(d(23), ten, two) and in_hours(d(1), ten, two) and not in_hours(d(12), ten, two)  # wraps
    # Clocks change (Sydney): 03:00 back to 02:00 on 5 Apr, 02:00 on to 03:00 on 4 Oct. Each boundary acts once, as
    # the main loop sees it minute by minute, in every mode that uses the hours.
    os.environ["TZ"] = "Australia/Sydney"
    time.tzset()
    half2 = dtime(2, 30)
    assert not in_hours(datetime(2026, 4, 5, 2, 10, fold=1), ten, half2)  # a restart in the repeated hour: still off
    assert in_hours(datetime(2026, 4, 5, 2, 10, fold=1), half2, ten)
    for day in (datetime(2026, 4, 5), datetime(2026, 10, 4)):
        for on, off, n in ((ten, half2, 1), (half2, ten, 1), (dtime(2), dtime(2, 59), 2)):
            for mode in ("schedule", "motion"):
                prev, acts = None, []
                for ts in range(int(day.timestamp()), int(day.timestamp()) + 6 * 3600, 60):
                    want = want_on(mode, datetime.fromtimestamp(ts), on, off, None, 900)
                    acts += [step(want, prev, False)] if prev is not None and want != prev else []
                    prev = want
                assert len(acts) == n, (day, on, off, mode, acts)
    night = d(3)
    assert want_on("always", night, six, ten, None, 900)
    assert not want_on("schedule", night, six, ten, 10, 900)
    assert want_on("motion", night, six, ten, 10, 900)
    assert not want_on("motion", night, six, ten, 901, 900)
    assert not want_on("motion", night, six, ten, None, 900)
    assert step(True, None, False) == "on" and step(True, False, False) == "on"  # on-time starts, or a cut in it
    assert step(True, True, True) == "check" and step(True, True, False) is None
    assert step(False, True, False) == "off" and step(False, None, True) is None and step(False, False, True) is None
    # first tick sets prev = not want: a start in on-hours wakes, one in off-hours sends standby
    assert step(True, not True, False) == "on" and step(False, not False, False) == "off"
    # after a cut in off-hours: re-check every 30 s for 10 min, nothing once the window ends
    assert step(False, False, True, True) == "settle" and step(False, False, False, True) is None
    assert step(False, False, True, False) is None and step(True, True, True, True) == "check"
    assert follow_up("check", "standby", False) == "on" and follow_up("check", "off", False) == "on"  # signal: off
    assert follow_up("check", "unknown", True) == "on" and follow_up("check", "unknown", False) is None  # IR: never
    assert follow_up("check", "on", True) is None and follow_up("settle", "unknown", False) == "off"
    assert follow_up("settle", "standby", True) is None and follow_up("settle", "off", True) is None
    # Each method through a day from a power cut at 03:00, as main() runs it, the TV back on by itself after the cut,
    # and turned off at 12:00 (the remote; the console for signal). What each reports: CEC the truth, IR nothing,
    # signal the last send.
    for mode in ("always", "schedule", "motion"):
        for method in ("cec", "ir", "signal"):
            power, sent, prev, next_check, answered = "on", [], None, 0, False
            for t in range(0, 24 * 3600, 30):
                now = d(3) + timedelta(seconds=t)
                if now == d(12):
                    power = "off"
                want = want_on(mode, now, six, ten, None, 900)
                prev = not want if prev is None else prev
                action = send = step(want, prev, t >= next_check, t < 600)
                if action in ("check", "settle"):
                    seen = {"cec": "standby" if power == "off" else "on", "ir": "unknown", "signal": power}[method]
                    answered = answered or seen == "on"
                    send = follow_up(action, seen, answered)
                if send:
                    sent.append((now.hour, send))
                    power = send
                if action in ("on", "check"):
                    next_check = t + POLL
                elif action in ("off", "settle"):
                    next_check = t + 30
                prev = want
            ons = [h for h, a in sent if a == "on"]
            offs = [h for h, a in sent if a == "off" and h != 3]
            assert offs == ([] if mode == "always" else [22]), (mode, method, sent)
            if method == "ir":  # one on when on-time starts, never again; standby re-sent for 10 min after the cut
                assert ons == [3 if mode == "always" else 6], (mode, sent)
                assert sent.count((3, "off")) == (0 if mode == "always" else 20), (mode, sent)
            else:  # one standby after the cut, which the TV reports; the 12:00 standby undone at the next check
                assert ons == ([3, 12] if mode == "always" else [6, 12]), (mode, method, sent)
                assert sent.count((3, "off")) == (0 if mode == "always" else 1), (mode, method, sent)
    # Overrides through a day in each mode: on from 23:00 to 01:00, off from 12:00 to 14:00. Each mode takes over again
    # when one ends; manual modes send nothing then. Until the clock can be trusted they wait.
    for mode in MODES:
        prev, sent = None, []
        for t in range(0, 24 * 3600, 60):
            now = d(3) + timedelta(seconds=t)
            want = wanted(mode, now, six, ten, None, 900, {23: "on", 0: "on", 12: "off", 13: "off"}.get(now.hour))
            if want is None:
                prev = None
                continue
            prev = not want if prev is None else prev
            if action := step(want, prev, False):
                sent.append((now.hour, action))
            prev = want
        assert sent == {"always": [(3, "on"), (12, "off"), (14, "on")],
                        "manual": [(12, "off"), (23, "on")], "manual+motion": [(12, "off"), (23, "on")]}.get(
            mode, [(3, "off"), (6, "on"), (12, "off"), (14, "on"), (22, "off"), (23, "on"), (1, "off")]), (mode, sent)
    assert wanted("schedule", d(3), six, ten, None, 900, "off", trusted=False) is True
    assert wanted("manual", d(3), six, ten, None, 900, "on", trusted=False) is None
    # When one ends: the next TV_ON or TV_OFF by default (modes with hours only), a duration, or a time's next pass;
    # instants, so a clock change in between counts real hours.
    ts = lambda *a: datetime(*a).timestamp()
    assert until([], d(23), "schedule", six, ten) == ts(2026, 1, 2, 6) and until([], d(12), "motion", six, ten) == \
        ts(2026, 1, 1, 22)
    assert until(["4h"], d(12), "always", six, ten) == ts(2026, 1, 1, 16)
    assert until(["1h30m"], d(12), "manual", six, ten) - d(12).timestamp() == 5400
    assert until(["2d"], d(12), "manual", six, ten) - d(12).timestamp() == 2 * 86400
    assert until(["until", "07:00"], d(23), "always", six, ten) == ts(2026, 1, 2, 7)
    assert until(["until", "7:00"], d(6), "always", six, ten) == ts(2026, 1, 1, 7)
    assert until(["until", "03:00"], datetime(2026, 4, 5, 1), "always", six, ten) - ts(2026, 4, 5, 1) == 3 * 3600
    assert until(["until", "07:00"], datetime(2026, 10, 4, 1), "always", six, ten) - ts(2026, 10, 4, 1) == 5 * 3600
    for bad in ([], ["0m"], [""], ["32d"], ["4x"], ["h"], ["until"], ["until", "25:00"], ["4h", "x"]):
        try:
            until(bad, d(12), "always", six, ten)
            raise AssertionError(bad)
        except ValueError:
            pass
    assert settings({"POWER_MODE": "motion", "TV_ON": "06:00"})[0] == "always"
    assert settings({"POWER_MODE": "schedule", "TV_ON": "06:00", "TV_OFF": "06:00"})[0] == "always"
    assert settings({"POWER_MODE": "bogus"})[0] == "always"
    assert settings({"POWER_MODE": "manual"})[0] == "manual"  # needs no hours
    assert settings({"POWER_MODE": "manual+motion"})[0] == "manual+motion"
    last = 0  # manual+motion: present from the start, stays 20 min (sensor held high), leaves 15 min, comes back
    for now, seen in [(t, t < 1200) for t in range(0, 3000, 10)]:
        wake, last = presence(last, now, seen, 900)
        assert not wake  # never woken while people stay or the room is empty
    assert presence(last, 3000, True, 900)[0] and not presence(2990, 3000, True, 900)[0]  # back after 15 min: wake
    assert settings({"TV_ON": "06:00", "TV_OFF": "22:00", "IDLE_MIN": "x"})[3] == 900
    assert settings({"TV_ON": "06:00", "TV_OFF": "22:00", "IDLE_MIN": "0"})[3] == 60  # 0 would never wake
    with tempfile.TemporaryDirectory() as tmp:
        STARTED, PLANNED = os.path.join(tmp, "started"), os.path.join(tmp, "planned")
        assert after_power_cut() and not after_power_cut()  # power cut, then a service restart in the same boot
        os.remove(STARTED)
        open(PLANNED, "w").close()
        assert not after_power_cut() and not os.path.exists(PLANNED)  # nightly reboot: marker used up
        SYNCED, RTC = os.path.join(tmp, "synced"), os.path.join(tmp, "rtc")
        assert not clock_ok()  # power cut, no battery, no NTP yet
        with open(RTC, "w") as f:
            f.write("86400\n")  # RTC lost power: 1970
        assert not clock_ok()
        with open(RTC, "w") as f:
            f.write(f"{CLOCK_FLOOR + 1}\n")  # warm reboot, or a battery
        assert clock_ok()
        os.remove(RTC)
        open(SYNCED, "w").close()
        assert clock_ok()
    # The override file: kept until its instant, nothing from a bad one; set, shown and cleared as tvlink override
    with tempfile.TemporaryDirectory() as tmp:
        path, conf = os.path.join(tmp, "override"), os.path.join(tmp, "tvlink.conf")
        for text, want in (('{"power": "on", "until": 1000}', ("on", 1000.0)), ('{"power": "x", "until": 1000}', None),
                           ('{"power": "off"}', None), ("{", None), ("[]", None)):
            with open(path, "w") as f:
                f.write(text)
            assert read_override(path, 999) == want and read_override(path, 1000) is None, text
        CLI = os.path.join(os.path.dirname(os.path.abspath(__file__)), "tvlink")
        os.environ["TVLINK_CONF"] = conf
        with open(conf, "w") as f:
            f.write("POWER_MODE=always\n")
        assert override(["off", "90m"], path).startswith("Override: TV off until ")
        assert os.stat(path).st_mode & 0o777 == 0o600 and read_override(path)[0] == "off"
        assert override([], path).startswith("off until ") and override(["clear"], path).startswith("Override cleared")
        assert override([], path) == "none" and override(["clear"], path)
        for bad in (["on"], ["sideways"], ["on", "until", "noon"]):  # always has no hours to end it
            try:
                override(bad, path)
                raise AssertionError(bad)
            except ValueError:
                pass
        with open(conf, "w") as f:
            f.write("POWER_METHOD=none\n")
        try:
            override(["on", "1h"], path)
            raise AssertionError("none")
        except ValueError as e:
            assert "POWER_METHOD=none" in str(e)
        del os.environ["TVLINK_CONF"]
    # The conf as staff edit it on a PC, read through the sibling tvlink: never run, odd lines handled.
    with tempfile.TemporaryDirectory() as tmp:
        conf = os.path.join(tmp, "tvlink.conf")
        with open(conf, "w", newline="") as f:
            f.write("\ufeffOVERLAY_CORNER=top-left\n"  # a BOM some editors put first
                    "BOARD_URL=https://old.example.com/d/x\n"
                    "BOARD_URL = https://board.example.com/d/abc?v=#top  # note\n"
                    "SOURCE='folder'\n"
                    'FIT="cover" # quoted, then a note\n'
                    "TV_ON=06:30 # opens\r\n"
                    "CEC=$(touch pwned)\n"
                    'POWER_MODE="mo"tion"\n'
                    "SLIDE_SECONDS=7s\n"
                    "IDLE_MIN=5")
        with open(conf, "ab") as f:
            f.write(b"\nWIFI1_SSID=Caf\xe9")  # saved as Windows-1252 on a PC: read, never a crash
        cli = os.path.join(os.path.dirname(os.path.abspath(__file__)), "tvlink")
        got = read_conf(cli, cwd=tmp, env=dict(os.environ, TVLINK_CONF=conf))
        assert got.pop("VERSION")
        want = {"BOARD_URL": "https://board.example.com/d/abc?v=#top", "SOURCE": "folder", "FIT": "cover",
                "TV_ON": "06:30", "TV_OFF": "22:00", "POWER_METHOD": "cec", "POWER_MODE": 'mo"tion',
                "SLIDE_SECONDS": "10", "IDLE_MIN": "5", "MOTION_PIN": "17", "RESOLUTION": "1920x1080@60",
                "OVERLAY_CORNER": "top-left", "WIFI1_SSID": "Caf\ufffd"}
        assert {k: got.get(k) for k in want} == want, got
        assert not os.path.exists(os.path.join(tmp, "pwned"))
        # The old CEC=0 still means none, unless POWER_METHOD says otherwise; a bad method falls back.
        for text, method in (("CEC=0", "none"), ("CEC=0\nPOWER_METHOD=ir", "ir"), ("POWER_METHOD=infrared", "cec"),
                             ("CEC=0\nPOWER_METHOD=infrared", "none"), ("POWER_METHOD=signal", "signal")):
            with open(conf, "w") as f:
                f.write(text + "\n")
            assert read_conf(cli, env=dict(os.environ, TVLINK_CONF=conf))["POWER_METHOD"] == method, text
    print("ok")


