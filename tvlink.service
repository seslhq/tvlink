[Unit]
Description=tvlink board kiosk
# No network-online wait: the splash shows at once and hands over when the board answers.
After=systemd-user-sessions.service getty@tty1.service
Conflicts=getty@tty1.service
StartLimitIntervalSec=0

[Service]
User=kiosk
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
RuntimeDirectory=tvlink
ExecStart=/usr/local/bin/tvlink kiosk
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
