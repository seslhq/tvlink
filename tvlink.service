[Unit]
Description=tvlink board kiosk
# No network-online wait: the splash shows at once and hands over when the board answers.
After=systemd-user-sessions.service getty@tty1.service
Conflicts=getty@tty1.service
StartLimitIntervalSec=0

[Service]
User=kiosk
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
RuntimeDirectory=tvlink
# The session's home is in RAM: /home/kiosk is root's and read-only, so nothing lands on the card and the browser can
# plant nothing that runs later. Mesa's shader cache is capped, so /run (10% of RAM) can't fill.
Environment=HOME=/run/tvlink MESA_SHADER_CACHE_MAX_SIZE=16M
ExecStart=/usr/local/bin/tvlink kiosk
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
