# tvlink config, read from /boot/firmware/tvlink.conf. Change with `sudo tvlink set KEY=value`, which
# restarts what uses it, or edit and reboot. Put notes on their own line starting with #; to keep " #" in a value,
# quote the whole value. `tvlink show` prints what tvlink reads.

# Page to show full screen, eg https://dashboard.example.com/board
BOARD_URL=

# Local content: images (jpg, png, webp, gif, svg) and videos (MP4, H.264) in the tvlink folder on this SD card,
# played by file name; name.30s.jpg shows that image for 30s. An index.html there is shown as a page instead.
#   auto    the board when it answers; local content while it does not (or with no BOARD_URL)
#   folder  local content only, no network needed
SOURCE=auto
# Seconds per image, and contain (whole image, black bars) or cover (fill the screen, crop the edges).
SLIDE_SECONDS=10
FIT=contain

# When the TV is on:
#   always         on 24/7
#   schedule       on from TV_ON to TV_OFF, standby at TV_OFF
#   motion         as schedule; outside those hours a motion sensor wakes it, standby after IDLE_MIN without motion
#   manual         people use the TV remote; the Pi only wakes the TV after a power cut
#   manual+motion  as manual, and the sensor wakes it when someone arrives after IDLE_MIN with nobody seen
POWER_MODE=schedule

# On-hours for schedule and motion, 24h Pi local time. TV_OFF earlier than TV_ON runs past midnight.
TV_ON=06:00
TV_OFF=22:00

# Motion modes: IDLE_MIN minutes, and the GPIO (BCM number) the sensor's output is wired to.
IDLE_MIN=15
MOTION_PIN=17

# How the Pi turns the TV on and off:
#   cec     HDMI-CEC (CEC on in the TV's menu)
#   ir      infrared, through an IR LED on IR_TX_PIN; the TV's state is then unknown
#   signal  the HDMI signal off and on, for a TV that sleeps without one and wakes with it
#   none    never touch the TV
POWER_METHOD=cec
# ir: built-in codes for a brand (lg, samsung, sony, toshiba), or learned (sudo tvlink ir learn on, then off). The
# pins are GPIO (BCM) numbers; IR_RX_PIN (a receiver, to learn codes) may be blank. Pin changes need a reboot.
IR_CODES=learned
IR_TX_PIN=18
IR_RX_PIN=23

# HDMI output mode, eg 1920x1080@60 or 1280x720@60; auto = the TV's preferred mode. Set when the kiosk starts.
RESOLUTION=1920x1080@60
# 1 = HDMI0 counts as connected even while the TV is off or on another input (with sudo tvlink edid capture, the
# Pi keeps the TV's modes). Needs a reboot.
HDMI_FORCE_HOTPLUG=0

# Corner of the status badge: bottom-right, bottom-left, top-right, top-left, or off.
OVERLAY_CORNER=bottom-right

# More local content, played ahead of the tvlink folder above, first one with files wins:
#   USB_CONTENT=1  a USB stick (FAT or exFAT) with a tvlink folder at its root, read-only, while it is plugged in
#   CONTENT_URL    https link to a manifest of files (docs/configuration.md), synced every CONTENT_SYNC_MIN minutes
USB_CONTENT=0
CONTENT_URL=
CONTENT_SYNC_MIN=15

# 1 = keep an hourly screenshot of the live page; a start with no network and no local content shows it, marked
# "Offline, from" when it was taken.
LAST_GOOD=0
# Restart the browser daily at HH:MM, eg 04:00 (not in the first hour after boot). Blank: never.
BROWSER_RESTART=

# Wi-Fi, added at each boot (Ethernet needs nothing). Quote names and passwords with spaces or #; a blank password
# means an open network. WIFI2 is a second network, eg the next one when the site changes its Wi-Fi.
WIFI_COUNTRY=
WIFI1_SSID=
WIFI1_PSK=
WIFI2_SSID=
WIFI2_PSK=
# 1 = after HOTSPOT_MIN minutes with no network, a Wi-Fi hotspot (tvlink-<hostname>, a new password each time, both on
# the TV) to reach the console at http://10.42.0.1 from a phone and set the Wi-Fi; it stops once the unit is online.
HOTSPOT=0
HOTSPOT_MIN=5

# TUNNEL_TOKEN, a Cloudflare Tunnel to the console (docs/cloudflare.md), is never read from this file: set it with
# sudo tvlink set TUNNEL_TOKEN=... or in the console, which keep it root-only on the unit.

# Blank: install upgrades every night (canary units). Mon, Tue, Wed, Thu, Fri, Sat or Sun, spelled exactly so: weekly,
# days after the canaries; anything else counts as blank. Edit here, then rerun install.sh: tvlink set and a reboot
# do not apply it.
UPDATE_DAY=
